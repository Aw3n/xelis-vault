const ADMIN_KEY: string = "a"
const ORACLE_KEY: string = "oc"
const XUSD_CONTRACT_KEY: string = "xc"
const XUSD_ASSET_KEY: string = "xa"
const TREASURY_KEY: string = "tr"

hook constructor() -> u64 {
    Storage::new().store(ADMIN_KEY, get_caller().expect("nocaller"))
    return 0
}

fn only_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("nocaller")
    let admin: Address = s.load(ADMIN_KEY).expect("anset")
    require(caller == admin, "notauth")
}

entry set_oracle(h: Hash) -> u64 { only_admin(); Storage::new().store(ORACLE_KEY, h); return 0 }
entry set_xusd(c: Hash, a: Hash) -> u64 { only_admin(); let s: Storage = Storage::new(); s.store(XUSD_CONTRACT_KEY, c); s.store(XUSD_ASSET_KEY, a); return 0 }
entry set_treasury(a: Address) -> u64 { only_admin(); Storage::new().store(TREASURY_KEY, a); return 0 }

entry psm_mint(xel_amount: u64, min_xusd_out: u64) -> u64 {
    require(xel_amount > 0, "amtgt0")
    require(min_xusd_out > 0, "noslippage")
    let s: Storage = Storage::new()
    let xa: Hash = s.load(XUSD_ASSET_KEY).expect("xans")

    let oh: Hash = s.load(ORACLE_KEY).expect("ocns")
    let oc: Contract = Contract::new(oh).expect("ocnf")
    let price: u64 = oc.call(3u16, [Hash::zero()], {})
    require(price > 0, "noprice")

    let gross_xusd: u64 = xel_amount * price / 100000000
    let net_xusd: u64 = gross_xusd - (gross_xusd * 50 / 10000)
    require(net_xusd >= min_xusd_out, "slippage")

    let caller: Address = get_caller().expect("nocaller")
    let dep: u64 = get_deposit_for_asset(Hash::zero()).expect("insdep")
    require(dep >= xel_amount, "insdep")

    let xc_hash: Hash = s.load(XUSD_CONTRACT_KEY).expect("xcns")
    let treasury: Address = s.load(TREASURY_KEY).expect("trns")
    let xc: Contract = Contract::new(xc_hash).expect("xcnf")
    let fee: u64 = gross_xusd * 50 / 10000
    let total: u64 = net_xusd + fee
    if total > 0 {
        let _: u64 = xc.call(26u16, [total], {})
    }
    if net_xusd > 0 {
        let ok: bool = transfer(caller, net_xusd, xa)
        require(ok, "txfail1")
    }
    if fee > 0 {
        let ok: bool = transfer(treasury, fee, xa)
        require(ok, "txfail2")
    }
    return 0
}
