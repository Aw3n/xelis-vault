hook constructor() -> u64 { return 0 }

entry psm_mint(xel_amount: u64, min_xusd_out: u64) -> u64 {
    require(xel_amount > 0, "amtgt0")
    require(min_xusd_out > 0, "noslippage")

    let oc: Contract = Contract::new(Hash::from_hex("147ab6aa686a5268396b39bc7d78de7e9e913dd6df7d0ae145a7eef28f163f2a")).expect("ocnf")
    let price: u64 = oc.call(3u16, [Hash::zero()], {})
    require(price > 0, "noprice")

    let gross_xusd: u64 = xel_amount * price / 100000000
    let net_xusd: u64 = gross_xusd - (gross_xusd * 50 / 10000)
    require(net_xusd >= min_xusd_out, "slippage")

    let caller: Address = get_caller().expect("nocaller")
    let dep: u64 = get_deposit_for_asset(Hash::zero()).expect("insdep")
    require(dep >= xel_amount, "insdep")

    let xc: Contract = Contract::new(Hash::from_hex("5d4a8d533068de04969adc381bad8728a19f6d0b34e715cca3d9dfe09a568b6a")).expect("xcnf")
    let treasury: Address = Address::from_string("xet:czr9q8k5xlzqdptq7n2vapyjfduldts6tw3e6apl99vknzvmu4zsq8z9j8v")
    let xa: Hash = Hash::from_hex("f7bd8984eac7706103cef3d8dca938c9bd92d1bb9c77c1057740ac6a817cf0a7")

    let fee: u64 = gross_xusd * 50 / 10000
    let total: u64 = net_xusd + fee
    if total > 0 {
        let _: u64 = xc.call(26u16, [total], {})
    }
    if net_xusd > 0 {
        let ok: bool = transfer(caller, net_xusd, xa)
        require(ok, "txfail1")
    }
    if fee > 0 {
        let ok: bool = transfer(treasury, fee, xa)
        require(ok, "txfail2")
    }
    return 0
}
