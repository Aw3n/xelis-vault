hook constructor() -> u64 {
    Storage::new().store("a", 1u64);
    return 0
}

// Test 1: call with just Hash
entry test_hash(contract: Hash, entry: u16) -> u64 {
    let c: Contract = Contract::new(contract).expect("cnf");
    let r: u64 = c.call(entry, [Hash::zero()], {});
    Storage::new().store("r", r);
    return 0
}

// Test 2: call with just u64
entry test_u64(contract: Hash, entry: u16, val: u64) -> u64 {
    let c: Contract = Contract::new(contract).expect("cnf");
    let r: u64 = c.call(entry, [val], {});
    Storage::new().store("r2", r);
    return 0
}
