// ID 16: register_service
// Whitelist a contract as an authorized service allowed to call slash_miner / distribute_reward.
// @caller: admin (or timelock as contract caller)
// @params: service_id - service slot to assign (1..=8)
// @params: contract_hash - hash of the contract being authorized
// @returns: 0 on success
// @security: only_admin
entry register_service(service_id: u8, contract_hash: Hash) -> u64 {
    only_admin()
    require(service_id >= 1 && service_id <= 8, "badservice")
    Storage::new().store(SERVICE_PREFIX + contract_hash.to_hex(), service_id)
    return 0
}

// ID 17: unregister_service
// Revoke a contract's authorized-service status.
// @caller: admin (or timelock as contract caller)
// @params: contract_hash - hash of the contract being de-authorized
// @returns: 0 on success
// @security: only_admin
entry unregister_service(contract_hash: Hash) -> u64 {
    only_admin()
    Storage::new().delete(SERVICE_PREFIX + contract_hash.to_hex())
    return 0
}

// ID 18: set_min_stake
// Update the minimum stake required to register / remain active as a miner.
// @caller: admin (or timelock as contract caller)
// @params: amount - new minimum stake (must be >= 1_000_000_000)
// @returns: 0 on success
// @security: only_admin, enforces lower bound
entry set_min_stake(amount: u64) -> u64 {
    only_admin()
    require(amount >= 1000000000, "badval")
    Storage::new().store(MIN_STAKE_KEY, amount)
    return 0
}

// ID 19: set_heartbeat_interval
// Update the minimum number of blocks between two heartbeats from the same miner.
// @caller: admin (or timelock as contract caller)
// @params: blocks - new heartbeat interval (must be in [10, 1000])
// @returns: 0 on success
// @security: only_admin, enforces bounded range
entry set_heartbeat_interval(blocks: u64) -> u64 {
    only_admin()
    require(blocks >= 10 && blocks <= 1000, "badval")
    Storage::new().store(HEARTBEAT_INTERVAL_KEY, blocks)
    return 0
}

// ID 20: set_heartbeat_timeout
