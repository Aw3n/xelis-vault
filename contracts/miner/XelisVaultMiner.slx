entry set_timelock(tl: Hash) -> u64 { only_admin() Storage::new().store(TIMELOCK_KEY, tl) return 0 }

// ID 30: set_guardian
// Set the guardian address able to pause the contract and trigger circuit breakers.
// @caller: admin (or timelock as contract caller)
// @params: g - new guardian address
// @returns: 0 on success
// @security: only_admin
entry set_guardian(g: Address) -> u64 { only_admin() Storage::new().store(GUARDIAN_KEY, g) return 0 }

// ID 31: set_emergency
// Rotate the emergency-key holder (only the current emergency holder may do this).
// @caller: current emergency-key holder only
// @params: e - new emergency address
// @returns: 0 on success
// @security: caller must equal stored EMERGENCY_KEY (separate from admin auth)
entry set_emergency(e: Address) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let current: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == current, "notemg")
    s.store(EMERGENCY_KEY, e)
    return 0
}

// ID 32: pause
// Halt all state-mutating user entries (register / stake / heartbeat / etc.).
// @caller: guardian or admin
// @params: reason - free-form reason string (off-chain audit trail only)
// @returns: 0 on success
// @security: only_guardian_or_admin; sets PAUSED_KEY = true; read-only entries remain callable
entry pause(reason: string) -> u64 { only_guardian_or_admin() Storage::new().store(PAUSED_KEY, true) return 0 }

// ID 33: unpause
// Resume normal operation after a pause.
// @caller: admin only (guardian cannot unpause, only pause)
// @returns: 0 on success
// @security: only_admin; sets PAUSED_KEY = false
entry unpause() -> u64 { only_admin() Storage::new().store(PAUSED_KEY, false) return 0 }

// ID 34: transfer_admin
// Transfer admin rights to a new address.
// @caller: admin (or timelock as contract caller)
// @params: new_admin - address of the new admin
// @returns: 0 on success
// @security: only_admin; immediate effect (no two-step confirmation in v5.1)
entry transfer_admin(new_admin: Address) -> u64 { only_admin() Storage::new().store(ADMIN_KEY, new_admin) return 0 }

// ID 35: get_version
// Return the contract version string.
// @caller: anyone (read-only)
// @returns: VERSION constant
// @security: read-only, no access control
entry get_version() -> string { return VERSION }

// ============================================================================
// FIX #14: Two-step emergency_withdraw — announce + execute after delay
// ============================================================================

const EMERGENCY_REQUEST_TOPO_KEY: string = "ert"
const EMERGENCY_DELAY_BLOCKS: u64 = 17280 // ~24h at 5s/block

// ID 36: request_emergency_withdraw
// Announce (step 1/2) an emergency withdrawal of all contract-held assets; starts the EMERGENCY_DELAY_BLOCKS countdown.
// @caller: current emergency-key holder only
// @returns: 0 on success
// @security: caller must equal stored EMERGENCY_KEY; records request topo for later enforcement
entry request_emergency_withdraw() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let e: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == e, "notemg")
    s.store(EMERGENCY_REQUEST_TOPO_KEY, get_current_topoheight())
    return 0
}

// ID 37: cancel_emergency_withdraw
// Cancel a pending emergency withdrawal request (undo step 1).
// @caller: current emergency-key holder only
// @returns: 0 on success
// @security: caller must equal stored EMERGENCY_KEY; clears EMERGENCY_REQUEST_TOPO_KEY
entry cancel_emergency_withdraw() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let e: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == e, "notemg")
    s.delete(EMERGENCY_REQUEST_TOPO_KEY)
    return 0
}

// ID 38: execute_emergency_withdraw (only after delay)
// Execute (step 2/2) a previously announced emergency withdrawal; drains the contract's balance of one asset.
// @caller: current emergency-key holder only
// @params: asset - asset hash to drain
// @returns: 0 on success
// @security: caller must equal stored EMERGENCY_KEY, requires prior request, requires EMERGENCY_DELAY_BLOCKS (~24h) to have elapsed; deletes the request after execution
entry execute_emergency_withdraw(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let e: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == e, "notemg")
    let req_topo: u64 = s.load(EMERGENCY_REQUEST_TOPO_KEY).unwrap_or(0)
    require(req_topo > 0, "norequest")
    let now_topo: u64 = get_current_topoheight()
    require(now_topo >= req_topo + EMERGENCY_DELAY_BLOCKS, "toosoon")
    s.delete(EMERGENCY_REQUEST_TOPO_KEY)
    let bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    if bal > 0 { transfer(caller, bal, asset) }
    return 0
}

// ============================================================================
// pub fn (read-only, NOT callable cross-contract — use entry wrappers above)
// ============================================================================
// Read-only access to a miner's full public state.
// @caller: anyone (read-only)
// @params: addr - miner address to query
// @returns: tuple of (endpoint_url, miner_pubkey, stake, services_mask, reputation, valid_submissions, successful_anchors, total_submissions, total_rewards_earned, total_slashed, active); zeroed tuple if miner does not exist
// @security: read-only, no access control
pub fn get_miner(addr: Address) -> (string, Hash, u64, u8, u64, u64, u64, u64, u64, u64, bool) {
    let s: Storage = Storage::new()
    let miner_opt: optional<Miner> = s.load(MINER_PREFIX + addr.to_string())
    if miner_opt.is_none() { return ("", Hash::zero(), 0, 0, 0, 0, 0, 0, 0, 0, false) }
    let miner: Miner = miner_opt.expect("err")
    return (
        miner.endpoint_url, miner.miner_pubkey, miner.stake, miner.services_mask,
        miner.reputation, miner.valid_submissions, miner.successful_anchors,
        miner.total_submissions, miner.total_rewards_earned, miner.total_slashed,
        miner.active
    )
}

// Read-only access to the address of the miner at the given index in the registration list.
// @caller: anyone (read-only)
// @params: index - 0-based position in MINER_LIST_PREFIX storage
// @returns: miner Address
// @security: read-only, no access control; requires index < MINERS_COUNT
pub fn get_miner_at(index: u64) -> Address {
    let s: Storage = Storage::new()
    let count: u64 = s.load(MINERS_COUNT_KEY).unwrap_or(0)
    require(index < count, "oob")
    return s.load(MINER_LIST_PREFIX + index.to_string(10u32)).expect("err")
}

// Read-only count of currently-active miners.
// @caller: anyone (read-only)
// @returns: number of miners whose active flag is true
// @security: read-only, no access control; iterates the whole miner list
pub fn get_active_miners_count() -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(MINERS_COUNT_KEY).unwrap_or(0)
    let active: u64 = 0
    let i: u64 = 0
    while i < count {
        let addr: Address = s.load(MINER_LIST_PREFIX + i.to_string(10u32)).expect("err")
        let miner: Miner = s.load(MINER_PREFIX + addr.to_string()).expect("err")
        if miner.active { active += 1 }
        i += 1
    }
    return active
}

// Read-only mapping from a raw reputation score (0..=10000) to a coarse tier.
// @caller: anyone (read-only)
// @params: rep - raw reputation score
// @returns: tier 4=excellent, 3=good, 2=warning, 1=critical, 0=banned
// @security: read-only, no access control; pure function
pub fn get_reputation_tier(rep: u64) -> u8 {
    if rep >= REP_EXCELLENT { return 4 }
    if rep >= REP_GOOD { return 3 }
    if rep >= REP_WARNING { return 2 }
    if rep >= REP_CRITICAL { return 1 }
    return 0
}

// Read-only snapshot of the protocol's tunable parameters.
// @caller: anyone (read-only)
// @returns: tuple of (min_stake, heartbeat_interval, heartbeat_timeout, base_reward_oracle, base_reward_chat, budget_factor, total_budget, distributed)
// @security: read-only, no access control
pub fn get_config() -> (u64, u64, u64, u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(MIN_STAKE_KEY).unwrap_or(DEFAULT_MIN_STAKE),
        s.load(HEARTBEAT_INTERVAL_KEY).unwrap_or(DEFAULT_HEARTBEAT_INTERVAL),
        s.load(HEARTBEAT_TIMEOUT_KEY).unwrap_or(DEFAULT_HEARTBEAT_TIMEOUT),
        s.load(BASE_REWARD_ORACLE_KEY).unwrap_or(DEFAULT_BASE_REWARD_ORACLE),
        s.load(BASE_REWARD_CHAT_KEY).unwrap_or(DEFAULT_BASE_REWARD_CHAT),
        s.load(BUDGET_FACTOR_KEY).unwrap_or(DEFAULT_BUDGET_FACTOR),
        s.load(TOTAL_BUDGET_KEY).unwrap_or(DEFAULT_TOTAL_BUDGET),
        s.load(DISTRIBUTED_KEY).unwrap_or(0)
    )
}

// Read-only snapshot of the budget / emission-pacing state.
// @caller: anyone (read-only)
// @returns: tuple of (total_budget, distributed, budget_factor, launch_topo, target_duration_blocks)
// @security: read-only, no access control
pub fn get_budget_info() -> (u64, u64, u64, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(TOTAL_BUDGET_KEY).unwrap_or(DEFAULT_TOTAL_BUDGET),
        s.load(DISTRIBUTED_KEY).unwrap_or(0),
        s.load(BUDGET_FACTOR_KEY).unwrap_or(DEFAULT_BUDGET_FACTOR),
        s.load(LAUNCH_TOPO_KEY).unwrap_or(0),
        s.load(TARGET_DURATION_BLOCKS_KEY).unwrap_or(DEFAULT_TARGET_DURATION)
    )
}

// Read-only check whether a contract hash is currently whitelisted as an authorized service.
// @caller: anyone (read-only)
// @params: contract_hash - hash to check
// @returns: true if the hash maps to a registered service_id > 0
// @security: read-only, no access control; mirrors the only_authorized_service() guard
pub fn is_authorized_service(contract_hash: Hash) -> bool {
    let service_id: u8 = Storage::new().load(SERVICE_PREFIX + contract_hash.to_hex()).unwrap_or(0)
    return service_id > 0
}

// Set the timelock contract hash (legacy alias kept for compatibility with StakedOracle.set_timelock_tl).
// @caller: admin (or timelock as contract caller)
// @params: tl - hash of the timelock contract
// @returns: 0 on success
// @security: only_admin
pub fn set_timelock_tl(tl: Hash) -> u64 { only_admin() Storage::new().store(TIMELOCK_KEY, tl) return 0 }
