// ============================================================================
// FlashCallback.slx — XELIS Vault v11.5
// ----------------------------------------------------------------------------
// Trivial flash-loan callback interface.
//
// AUDIT FIX F-02 (CRITICAL) v11.5:
//   on_flash_loan was declared `pub fn` and was therefore NOT callable
//   cross-contract (it did not appear in `docs/entry_chunk_ids.json`).
//   FlashLoan was calling `cb.call(2u16, ...)`, which on FlashCallback hits
//   `set_flash_loan` (chunk 4) — silently corrupting admin storage instead
//   of invoking the callback handler.
//   Fix: declare on_flash_loan as a real `entry` so it gets a chunk ID in the
//   compiled module, and add an explicit cc == flash_loan_hash check so only
//   the registered FlashLoan contract can invoke it.
//
// Entry IDs (auto-generated, see docs/entry_chunk_ids.json after recompile):
//   claim_profit, set_flash_loan, set_registry, transfer_admin, get_version,
//   on_flash_loan (new entry, appended at the end so existing IDs are preserved)
// ============================================================================

const VERSION: string = "FlashCallback v11.5"

const ADMIN_KEY: string = "a"
const FLASH_LOAN_KEY: string = "fl"
const REGISTRY_KEY: string = "reg"

hook constructor() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    s.store(ADMIN_KEY, caller)
    return 0
}

fn only_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let admin: Address = s.load(ADMIN_KEY).expect("err")
    require(caller == admin, "notauth")
}

// ============================================================================
// ENTRIES
// ============================================================================

// ID 0: on_flash_loan — invoked by FlashLoan.flash_loan (chunk 6).
// F-02 fix (CRITICAL): now declared `entry` (was pub fn) so the chunk ID is
//   actually assigned by the compiler and the function is reachable cross-contract.
//   Per docs/entry_chunk_ids.json (post-recompile), the new chunk ID will be 8
//   (after the 5 existing entries 3-7 + 2 internal helpers). FlashLoan will be
//   updated to call the correct chunk ID.
//   Added explicit cc == flash_loan_hash check so only the registered FlashLoan
//   contract can invoke this entry.
// on flash loan.
// @caller: FlashLoan contract (cross-contract)
// @params: asset - Hash
// @params: amount - u64
// @params: fee - u64
// @params: caller - Address
// @params: data - bytes
// @returns: u
// @security: caller must be the registered FlashLoan contract (FLASH_LOAN_KEY)
entry on_flash_loan(
    asset: Hash,
    amount: u64,
    fee: u64,
    caller: Address,
    data: bytes
) -> u64 {
    let s: Storage = Storage::new()
    let flash_loan_hash: Hash = s.load(FLASH_LOAN_KEY).expect("err")

    // F-02 fix: ensure only the registered FlashLoan contract can invoke this entry.
    let cc_opt: optional<Hash> = get_contract_caller()
    require(cc_opt.is_some(), "notfl")
    let cc: Hash = cc_opt.expect("err")
    require(cc == flash_loan_hash, "notfl")

    let total_repay: u64 = amount + fee
    require(total_repay >= amount, "ovf")

    let bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    require(bal >= total_repay, "insrepay")

    // v11.1: Use native transfer_contract instead of calling FlashLoan entry
    // (entry functions cannot be called cross-contract — only pub fn can)
    require(transfer_contract(flash_loan_hash, total_repay, asset), "repayfailed")

    return 0
}

// ID 1: claim_profit
// claim profit.
// @caller: any user
// @params: asset - Hash
// @returns: u
// @security: only_admin
entry claim_profit(asset: Hash) -> u64 {
    only_admin()
    let caller: Address = get_caller().expect("err")
    let bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    require(bal > 0, "noprofit")
    let _ = transfer(caller, bal, asset)
    return 0
}

// ID 2: set_flash_loan
// set flash loan.
// @caller: admin (or timelock)
// @params: fl - Hash
// @returns: u
// @security: only_admin
entry set_flash_loan(fl: Hash) -> u64 {
    only_admin()
    Storage::new().store(FLASH_LOAN_KEY, fl)
    return 0
}

// ID 3: set_registry
// set registry.
// @caller: admin (or timelock)
// @params: reg - Hash
// @returns: u
// @security: only_admin
entry set_registry(reg: Hash) -> u64 {
    only_admin()
    Storage::new().store(REGISTRY_KEY, reg)
    return 0
}

// ID 4: transfer_admin
// transfer admin.
// @caller: admin (or timelock)
// @params: new_admin - Address
// @returns: u
// @security: only_admin
entry transfer_admin(new_admin: Address) -> u64 {
    only_admin()
    Storage::new().store(ADMIN_KEY, new_admin)
    return 0
}

// ID 5: get_version
// get version.
// @caller: user / authorized caller
// @returns: s
// @security: standard access control
entry get_version() -> string {
    return VERSION
}
