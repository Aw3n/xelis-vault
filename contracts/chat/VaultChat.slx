// ============================================================================
// VaultChat.slx — XELIS Vault v5.0
// ----------------------------------------------------------------------------
// E2E encrypted chat with anchored Merkle roots, preserved from v4.2.
//
// NEW v5.0: anchor_messages() distributes a reward to the relayer via the
// XelisVaultMiner v5.0 contract: miner.call(18u16, [addr, 2u64, is_valid], {})
// where service_id=2 designates the chat service. The miner contract hash is
// stored in MINER_CONTRACT_KEY (set via the admin-only set_miner_contract
// pub fn). If MINER_CONTRACT_KEY is unset (Hash::zero()) the reward call is
// skipped gracefully so the chat still functions pre-miner-deployment.
//
// Two-step emergency_withdraw (IDs 20/21, "ert" key, 17280-block delay).
//
// Entry IDs (sequential, starting at 0):
//   0  : register_session
//   1  : create_group
//   2  : add_group_member
//   3  : remove_group_member
//   4  : anchor_messages
//   5  : revoke_session
//   6  : get_session_entry
//   7  : get_group_entry
//   8  : get_group_member_key_entry
//   9  : is_session_active_entry
//   10 : get_last_anchor_entry
//   11 : get_groups_count_entry
//   12 : get_group_members_count_entry
//   13 : set_relayer
//   14 : set_timelock
//   15 : set_guardian
//   16 : pause
//   17 : unpause
//   18 : transfer_admin
//   19 : get_version
//   20 : request_emergency_withdraw
//   21 : execute_emergency_withdraw
// ============================================================================

const VERSION: string = "VaultChat v5.0"

const ADMIN_KEY: string = "a"
const TIMELOCK_KEY: string = "tl"
const GUARDIAN_KEY: string = "gd"
const EMERGENCY_KEY: string = "ea"
const PAUSED_KEY: string = "pz"
const SESSION_PREFIX: string = "session_"
const GROUP_PREFIX: string = "group_"
const GROUP_MEMBER_PREFIX: string = "gm_"
const GROUP_MEMBERS_COUNT_PREFIX: string = "gmc_"
const LAST_MERKLE_ROOT_KEY: string = "lmr"
const LAST_ANCHOR_TOPO_KEY: string = "lat"
const TOTAL_MESSAGES_KEY: string = "tm"
const RELAYER_PREFIX: string = "relayer_"
const GROUPS_COUNT_KEY: string = "gc"
const MINER_CONTRACT_KEY: string = "mc"

const CHAT_SERVICE_ID: u64 = 2

const EMERGENCY_REQUEST_TOPO_KEY: string = "ert"
const EMERGENCY_DELAY_BLOCKS: u64 = 17280

struct Session {
    registered_at: u64,
    chat_pubkey: Hash,
    active: bool
}

struct Group {
    id: u64,
    group_pubkey: Hash,
    creator: Address,
    created_at: u64,
    active: bool
}

hook constructor() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    s.store(ADMIN_KEY, caller)
    s.store(GUARDIAN_KEY, caller)
    s.store(EMERGENCY_KEY, caller)
    s.store(PAUSED_KEY, false)
    s.store(TOTAL_MESSAGES_KEY, 0u64)
    s.store(GROUPS_COUNT_KEY, 0u64)
    s.store(MINER_CONTRACT_KEY, Hash::zero())
    return 0
}

fn only_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let admin: Address = s.load(ADMIN_KEY).expect("err")
    if caller == admin { return }
    let tl_opt: optional<Hash> = s.load(TIMELOCK_KEY)
    require(tl_opt.is_some(), "notauth")
    let tl: Hash = tl_opt.expect("err")
    let cc: Hash = get_contract_caller().expect("err")
    require(cc == tl, "notauth")
}

fn only_guardian_or_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let g: Address = s.load(GUARDIAN_KEY).expect("err")
    if caller == g { return }
    only_admin()
}

fn only_emergency() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let e: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == e, "notemg")
}

fn only_authorized_relayer() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let admin: Address = s.load(ADMIN_KEY).expect("err")
    if caller == admin { return }
    let is_relayer: bool = s.load(RELAYER_PREFIX + caller.to_string()).unwrap_or(false)
    require(is_relayer, "notrelayer")
}

fn when_not_paused() {
    let paused: bool = Storage::new().load(PAUSED_KEY).unwrap_or(false)
    require(!paused, "paused")
}

// ============================================================================
// ENTRIES
// ============================================================================

// ID 0: register_session
// Register or update the caller's chat session by storing their E2E chat public key.
// @caller: any user
// @params: chat_pubkey - Hash of the user's chat public key (must be non-zero)
// @returns: 0 on success
// @security: when_not_paused, rejects zero pubkey, creates new session or reactivates existing one
// register session.
entry register_session(chat_pubkey: Hash) -> u64 {
    when_not_paused()
    require(chat_pubkey != Hash::zero(), "badpubkey")
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let existing: optional<Session> = s.load(SESSION_PREFIX + caller.to_string())
    if existing.is_some() {
        let session: Session = existing.expect("err")
        session.chat_pubkey = chat_pubkey
        session.active = true
        s.store(SESSION_PREFIX + caller.to_string(), session)
    } else {
        let session: Session = Session {
            registered_at: get_current_topoheight(),
            chat_pubkey: chat_pubkey,
            active: true
        }
        s.store(SESSION_PREFIX + caller.to_string(), session)
    }
    return 0
}

// ID 1: create_group
// Create a new encrypted group chat with the creator's group public key.
// @caller: any user (becomes group creator)
// @params: group_pubkey - Hash of the group's shared public key (must be non-zero)
// @returns: new group id
// @security: when_not_paused, rejects zero pubkey, increments GROUPS_COUNT_KEY
// create group.
entry create_group(group_pubkey: Hash) -> u64 {
    when_not_paused()
    require(group_pubkey != Hash::zero(), "badpubkey")
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let id: u64 = s.load(GROUPS_COUNT_KEY).unwrap_or(0)
    let group: Group = Group {
        id: id,
        group_pubkey: group_pubkey,
        creator: caller,
        created_at: get_current_topoheight(),
        active: true
    }
    s.store(GROUP_PREFIX + id.to_string(10u32), group)
    s.store(GROUP_MEMBERS_COUNT_PREFIX + id.to_string(10u32), 0u64)
    s.store(GROUPS_COUNT_KEY, id + 1)
    return id
}

// ID 2: add_group_member
// Add a member to an existing group by storing their encrypted group key (creator-only).
// @caller: group creator only
// @params: group_id - target group id
// @params: member - address of the member to add (must have an active session)
// @params: encrypted_group_key - per-member encrypted group key bytes
// @returns: 0 on success
// @security: when_not_paused, only creator, requires group active, requires member has active session
// add group member.
entry add_group_member(group_id: u64, member: Address, encrypted_group_key: bytes) -> u64 {
    when_not_paused()
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("err")
    require(group.creator == caller, "notcreator")
    require(group.active, "ginactive")
    let member_session: Session = s.load(SESSION_PREFIX + member.to_string()).expect("err")
    require(member_session.active, "minactive")
    let key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + member.to_string()
    s.store(key, encrypted_group_key)
    let count_key: string = GROUP_MEMBERS_COUNT_PREFIX + group_id.to_string(10u32)
    let count: u64 = s.load(count_key).unwrap_or(0)
    s.store(count_key, count + 1)
    return 0
}

// ID 3: remove_group_member
// Remove a member from a group (creator-only).
// @caller: group creator only
// @params: group_id - target group id
// @params: member - address of the member to remove
// @returns: 0 on success
// @security: only creator, deletes stored encrypted group key, decrements member count
// remove group member.
entry remove_group_member(group_id: u64, member: Address) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("err")
    require(group.creator == caller, "notcreator")
    let key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + member.to_string()
    s.delete(key)
    let count_key: string = GROUP_MEMBERS_COUNT_PREFIX + group_id.to_string(10u32)
    let count: u64 = s.load(count_key).unwrap_or(0)
    if count > 0 {
        s.store(count_key, count - 1)
    }
    return 0
}

// ID 4: anchor_messages — distributes reward to relayer via XelisVaultMiner v5.0
// Anchor a Merkle root of off-chain encrypted messages on-chain and reward the relayer.
// @caller: authorized relayer (admin or whitelisted relayer)
// @params: merkle_root - Hash of the Merkle root being anchored (must be non-zero)
// @params: message_count - number of messages included in this batch (must be > 0)
// @params: msg_type - message type tag (reserved for protocol routing)
// @returns: 0 on success
// @security: only_authorized_relayer, updates last anchor + total messages counter, optional reward via cross-contract call to XelisVaultMiner entry 8 (skipped if miner contract unset)
// anchor messages.
entry anchor_messages(merkle_root: Hash, message_count: u64, msg_type: u8) -> u64 {
    only_authorized_relayer()
    require(merkle_root != Hash::zero(), "badroot")
    require(message_count > 0, "badcount")
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    s.store(LAST_MERKLE_ROOT_KEY, merkle_root)
    s.store(LAST_ANCHOR_TOPO_KEY, get_current_topoheight())
    let total: u64 = s.load(TOTAL_MESSAGES_KEY).unwrap_or(0)
    s.store(TOTAL_MESSAGES_KEY, total + message_count)

    // Reward the relayer via XelisVaultMiner v5.0 entry 8 (distribute_reward)
    // with service_id=2 (chat). Skipped if miner contract not configured.
    let miner_hash_opt: optional<Hash> = s.load(MINER_CONTRACT_KEY)
    if miner_hash_opt.is_some() {
        let miner_hash: Hash = miner_hash_opt.expect("err")
        if miner_hash != Hash::zero() {
            let miner: Contract = Contract::new(miner_hash).expect("err")
            let _ = miner.call(18u16, [caller, CHAT_SERVICE_ID, true], {})
        }
    }
    return 0
}

// ID 5: revoke_session
// Revoke (deactivate) a user's chat session (guardian/admin only; compliance lever).
// @caller: guardian or admin
// @params: user - address whose session should be revoked
// @returns: 0 on success
// @security: only_guardian_or_admin, requires existing session, sets active=false
// revoke session.
entry revoke_session(user: Address) -> u64 {
    only_guardian_or_admin()
    let s: Storage = Storage::new()
    let session_opt: optional<Session> = s.load(SESSION_PREFIX + user.to_string())
    require(session_opt.is_some(), "nosession")
    let session: Session = session_opt.expect("err")
    session.active = false
    s.store(SESSION_PREFIX + user.to_string(), session)
    return 0
}

// ID 6: get_session_entry
// Return the chat session details for a user.
// @caller: anyone
// @params: user - address whose session to look up
// @returns: tuple (chat_pubkey, registered_at_topo, active); returns (zero, 0, false) if no session
// @security: read-only view, no access control
// get session entry.
entry get_session_entry(user: Address) -> (Hash, u64, bool) {
    let s: Storage = Storage::new()
    let session_opt: optional<Session> = s.load(SESSION_PREFIX + user.to_string())
    if session_opt.is_none() {
        return (Hash::zero(), 0, false)
    }
    let session: Session = session_opt.expect("err")
    return (session.chat_pubkey, session.registered_at, session.active)
}

// ID 7: get_group_entry
// Return the public metadata of a group.
// @caller: anyone
// @params: group_id - target group id
// @returns: tuple (group_pubkey, creator, created_at_topo, active)
// @security: read-only view, no access control
// get group entry.
entry get_group_entry(group_id: u64) -> (Hash, Address, u64, bool) {
    let s: Storage = Storage::new()
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("err")
    return (group.group_pubkey, group.creator, group.created_at, group.active)
}

// ID 8: get_group_member_key_entry
// Return the encrypted group key stored for a specific member in a group.
// @caller: anyone
// @params: group_id - target group id
// @params: member - address whose encrypted key to retrieve
// @returns: encrypted group key Hash (zero if member not in group)
// @security: read-only view, no access control
// get group member key entry.
entry get_group_member_key_entry(group_id: u64, member: Address) -> Hash {
    let key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + member.to_string()
    let s: Storage = Storage::new()
    let opt: optional<Hash> = s.load(key)
    if opt.is_none() {
        return Hash::zero()
    }
    return opt.expect("err")
}

// ID 9: is_session_active_entry
// Return whether a user has an active chat session.
// @caller: anyone
// @params: user - address to check
// @returns: true if user has a session and it is active
// @security: read-only view, no access control
// is session active entry.
entry is_session_active_entry(user: Address) -> bool {
    let s: Storage = Storage::new()
    let session_opt: optional<Session> = s.load(SESSION_PREFIX + user.to_string())
    if session_opt.is_none() {
        return false
    }
    let session: Session = session_opt.expect("err")
    return session.active
}

// ID 10: get_last_anchor_entry
// Return the last anchored Merkle root, its topoheight, and the cumulative message count.
// @caller: anyone
// @returns: tuple (merkle_root, anchor_topo, total_messages)
// @security: read-only view, no access control
// get last anchor entry.
entry get_last_anchor_entry() -> (Hash, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(LAST_MERKLE_ROOT_KEY).unwrap_or(Hash::zero()),
        s.load(LAST_ANCHOR_TOPO_KEY).unwrap_or(0),
        s.load(TOTAL_MESSAGES_KEY).unwrap_or(0)
    )
}

// ID 11: get_groups_count_entry
// Return the total number of groups created.
// @caller: anyone
// @returns: count of groups
// @security: read-only view, no access control
// get groups count entry.
entry get_groups_count_entry() -> u64 {
    return Storage::new().load(GROUPS_COUNT_KEY).unwrap_or(0)
}

// ID 12: get_group_members_count_entry
// Return the current member count of a group.
// @caller: anyone
// @params: group_id - target group id
// @returns: member count
// @security: read-only view, no access control
// get group members count entry.
entry get_group_members_count_entry(group_id: u64) -> u64 {
    let key: string = GROUP_MEMBERS_COUNT_PREFIX + group_id.to_string(10u32)
    return Storage::new().load(key).unwrap_or(0)
}

// ID 13: set_relayer
// Whitelist (or remove) an address as an authorized message relayer.
// @caller: admin or timelock
// @params: addr - address to whitelist/unwhitelist
// @params: enabled - true to authorize, false to revoke
// @returns: 0 on success
// @security: only_admin, privileged configuration
// set relayer.
entry set_relayer(addr: Address, enabled: bool) -> u64 {
    only_admin()
    Storage::new().store(RELAYER_PREFIX + addr.to_string(), enabled)
    return 0
}

// ID 14: set_timelock
// Set the timelock contract hash allowed to invoke admin-gated entries.
// @caller: admin or timelock
// @params: tl - new timelock contract Hash
// @returns: 0 on success
// @security: only_admin, sets the alternate admin path
// set timelock.
entry set_timelock(tl: Hash) -> u64 {
    only_admin()
    Storage::new().store(TIMELOCK_KEY, tl)
    return 0
}

// ID 15: set_guardian
// Update the guardian address that may revoke sessions and pause the contract.
// @caller: admin or timelock
// @params: g - new guardian Address
// @returns: 0 on success
// @security: only_admin, privileged configuration
// set guardian.
entry set_guardian(g: Address) -> u64 {
    only_admin()
    Storage::new().store(GUARDIAN_KEY, g)
    return 0
}

// ID 16: pause
// Pause session registration, group creation, member add/remove, and message anchoring.
// @caller: guardian or admin
// @params: reason - human-readable pause reason
// @returns: 0 on success
// @security: only_guardian_or_admin, sets PAUSED_KEY to true
// pause.
entry pause(reason: string) -> u64 {
    only_guardian_or_admin()
    Storage::new().store(PAUSED_KEY, true)
    return 0
}

// ID 17: unpause
// Resume chat operations after a pause.
// @caller: admin or timelock
// @returns: 0 on success
// @security: only_admin (stricter than pause)
// unpause.
entry unpause() -> u64 {
    only_admin()
    Storage::new().store(PAUSED_KEY, false)
    return 0
}

// ID 18: transfer_admin
// Transfer the admin role to a new address (single-step; verify before calling).
// @caller: admin or timelock
// @params: new_admin - address that will become the new admin
// @returns: 0 on success
// @security: only_admin, single-step transfer — ensure new_admin is correct before committing
// transfer admin.
entry transfer_admin(new_admin: Address) -> u64 {
    only_admin()
    Storage::new().store(ADMIN_KEY, new_admin)
    return 0
}

// ID 19: get_version
// Return the contract version string.
// @caller: anyone
// @returns: semantic version string (e.g. "VaultChat v5.0")
// @security: read-only view, no access control
// get version.
entry get_version() -> string {
    return VERSION
}

// ID 20: request_emergency_withdraw
// First step of the 2-step emergency withdraw: record the current topoheight as request timestamp.
// @caller: emergency role
// @returns: 0 on success
// @security: only_emergency, starts 17280-block (~24h) timelock before execution
// request emergency withdraw.
entry request_emergency_withdraw() -> u64 {
    only_emergency()
    Storage::new().store(EMERGENCY_REQUEST_TOPO_KEY, get_current_topoheight())
    return 0
}

// ID 21: execute_emergency_withdraw
// Second step of the 2-step emergency withdraw: sweep the entire balance of an asset to the emergency role.
// @caller: emergency role
// @params: asset - which asset Hash to withdraw fully
// @returns: 0 on success
// @security: only_emergency, requires prior request_emergency_withdraw, enforced 17280-block delay, single-use (deletes request key)
// execute emergency withdraw.
entry execute_emergency_withdraw(asset: Hash) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let e: Address = s.load(EMERGENCY_KEY).expect("err")
    require(caller == e, "notemg")
    let req_topo: u64 = s.load(EMERGENCY_REQUEST_TOPO_KEY).unwrap_or(0)
    require(req_topo > 0, "norequest")
    let now_topo: u64 = get_current_topoheight()
    require(now_topo >= req_topo + EMERGENCY_DELAY_BLOCKS, "toosoon")
    s.delete(EMERGENCY_REQUEST_TOPO_KEY)
    let bal: u64 = get_balance_for_asset(asset).unwrap_or(0)
    if bal > 0 {
        let _ = transfer(caller, bal, asset)
    }
    return 0
}

// ============================================================================
// pub fn (read-only / admin helpers) — not counted for entry IDs
// ============================================================================

// Return the chat session details for a user.
// @caller: anyone
// @params: user - address whose session to look up
// @returns: tuple (chat_pubkey, registered_at_topo, active); returns (zero, 0, false) if no session
// @security: read-only view, no access control
// get session.
pub fn get_session(user: Address) -> (Hash, u64, bool) {
    let s: Storage = Storage::new()
    let session_opt: optional<Session> = s.load(SESSION_PREFIX + user.to_string())
    if session_opt.is_none() {
        return (Hash::zero(), 0, false)
    }
    let session: Session = session_opt.expect("err")
    return (session.chat_pubkey, session.registered_at, session.active)
}

// Return the public metadata of a group.
// @caller: anyone
// @params: group_id - target group id
// @returns: tuple (group_pubkey, creator, created_at_topo, active)
// @security: read-only view, no access control
// get group.
pub fn get_group(group_id: u64) -> (Hash, Address, u64, bool) {
    let s: Storage = Storage::new()
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("err")
    return (group.group_pubkey, group.creator, group.created_at, group.active)
}

// Return the encrypted group key stored for a specific member in a group.
// @caller: anyone
// @params: group_id - target group id
// @params: member - address whose encrypted key to retrieve
// @returns: encrypted group key Hash (zero if member not in group)
// @security: read-only view, no access control
// get group member key.
pub fn get_group_member_key(group_id: u64, member: Address) -> Hash {
    let key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + member.to_string()
    let s: Storage = Storage::new()
    let opt: optional<Hash> = s.load(key)
    if opt.is_none() {
        return Hash::zero()
    }
    return opt.expect("err")
}

// Return whether a user has an active chat session.
// @caller: anyone
// @params: user - address to check
// @returns: true if user has a session and it is active
// @security: read-only view, no access control
// is session active.
pub fn is_session_active(user: Address) -> bool {
    let s: Storage = Storage::new()
    let session_opt: optional<Session> = s.load(SESSION_PREFIX + user.to_string())
    if session_opt.is_none() {
        return false
    }
    let session: Session = session_opt.expect("err")
    return session.active
}

// Return the last anchored Merkle root, its topoheight, and the cumulative message count.
// @caller: anyone
// @returns: tuple (merkle_root, anchor_topo, total_messages)
// @security: read-only view, no access control
// get last anchor.
pub fn get_last_anchor() -> (Hash, u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(LAST_MERKLE_ROOT_KEY).unwrap_or(Hash::zero()),
        s.load(LAST_ANCHOR_TOPO_KEY).unwrap_or(0),
        s.load(TOTAL_MESSAGES_KEY).unwrap_or(0)
    )
}

// Return the total number of groups created.
// @caller: anyone
// @returns: count of groups
// @security: read-only view, no access control
// get groups count.
pub fn get_groups_count() -> u64 {
    return Storage::new().load(GROUPS_COUNT_KEY).unwrap_or(0)
}

// Return the current member count of a group.
// @caller: anyone
// @params: group_id - target group id
// @returns: member count
// @security: read-only view, no access control
// get group members count.
pub fn get_group_members_count(group_id: u64) -> u64 {
    let key: string = GROUP_MEMBERS_COUNT_PREFIX + group_id.to_string(10u32)
    return Storage::new().load(key).unwrap_or(0)
}

// Configure the XelisVaultMiner contract hash used for relayer reward distribution.
// @caller: admin or timelock
// @params: mh - new XelisVaultMiner contract Hash (use Hash::zero() to disable rewards)
// @returns: 0 on success
// @security: only_admin, privileged configuration; anchor_messages gracefully skips reward if unset
// set miner contract.
pub fn set_miner_contract(mh: Hash) -> u64 {
    only_admin()
    Storage::new().store(MINER_CONTRACT_KEY, mh)
    return 0
}

// Set the timelock contract hash (alternate admin path via contract-caller check).
// @caller: admin or timelock
// @params: tl - new timelock contract Hash
// @returns: 0 on success
// @security: only_admin, mirrors the entry version for read-only callers
// set timelock tl.
pub fn set_timelock_tl(tl: Hash) -> u64 {
    only_admin()
    Storage::new().store(TIMELOCK_KEY, tl)
    return 0
}

// ============================================================================
// v7.0: ON-CHAIN ENCRYPTED MESSAGE STORAGE
// ----------------------------------------------------------------------------
// Messages are stored on-chain so they survive even if all relayers disappear.
// Only encrypted blobs are stored (nobody can read them without the keys).
// Ring buffer: last 50 messages per user (older ones available from relayers).
// ============================================================================

const MSG_PREFIX: string = "msg_"
const MSG_COUNT_PREFIX: string = "msgc_"
const MSG_DELETED_PREFIX: string = "msgd_"
const CONV_DELETED_PREFIX: string = "convd_"
const MAX_ONCHAIN_MESSAGES: u64 = 50

// Store an encrypted message on-chain (called by sender or relayer)
// The encrypted blob is stored so the recipient can retrieve it later
// even if all relayers disappear.
entry store_message(
    recipient: Address,
    encrypted_blob: bytes,
    timestamp: u64
) -> u64 {
    when_not_paused()
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    // The sender IS the caller — no impersonation possible
    let sender: Address = caller
    
    // Get or create message counter for recipient
    let count_key: string = MSG_COUNT_PREFIX + recipient.to_string()
    let count: u64 = s.load(count_key).unwrap_or(0)
    
    // Ring buffer: overwrite oldest message if buffer is full
    let slot: u64 = count % MAX_ONCHAIN_MESSAGES
    let msg_key: string = MSG_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)
    
    // Store the message
    let msg_data: string = encrypted_blob.to_hex() + "|" + sender.to_string() + "|" + timestamp.to_string(10u32)
    s.store(msg_key, msg_data)
    s.store(count_key, count + 1)
    
    return count
}

// Retrieve an encrypted message from on-chain storage
// Returns the encrypted blob that the recipient can decrypt locally
pub fn get_message(recipient: Address, index: u64) -> string {
    let s: Storage = Storage::new()
    let msg_key: string = MSG_PREFIX + recipient.to_string() + "_" + index.to_string(10u32)
    let msg_opt: optional<string> = s.load(msg_key)
    if msg_opt.is_none() { return "" }
    return msg_opt.expect("err")
}

// Get how many messages a user has received (total, not just on-chain)
pub fn get_message_count(recipient: Address) -> u64 {
    return Storage::new().load(MSG_COUNT_PREFIX + recipient.to_string()).unwrap_or(0)
}

// Get how many messages are currently stored on-chain for a user
pub fn get_onchain_message_count(recipient: Address) -> u64 {
    let s: Storage = Storage::new()
    let total: u64 = s.load(MSG_COUNT_PREFIX + recipient.to_string()).unwrap_or(0)
    if total > MAX_ONCHAIN_MESSAGES { return MAX_ONCHAIN_MESSAGES }
    return total
}

// Delete a specific message (tombstone — blob replaced with empty)
// Both sender and recipient can delete
entry delete_message(recipient: Address, slot: u64) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    
    // Verify caller is either sender or recipient
    let msg_key: string = MSG_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)
    let msg_opt: optional<string> = s.load(msg_key)
    require(msg_opt.is_some(), "nomsg")
    
    let msg_data: string = msg_opt.expect("err")
    // Parse: blob|sender|timestamp
    let parts: string[] = msg_data.split("|")
    let sender: Address = Address::from_string(parts[1]).expect("err")
    
    require(caller == recipient || caller == sender, "notauth")
    
    // Replace with tombstone (keep sender + timestamp, clear blob)
    let tombstone: string = "DELETED|" + sender.to_string() + "|" + parts[2]
    s.store(msg_key, tombstone)
    s.store(MSG_DELETED_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32), true)
    
    return 0
}

// Delete all messages in a conversation (tombstone all)
// Only the recipient can do this for their inbox
entry delete_conversation(peer: Address) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    
    // Delete all on-chain messages from this peer
    let count_key: string = MSG_COUNT_PREFIX + caller.to_string()
    let count: u64 = s.load(count_key).unwrap_or(0)
    let limit: u64 = count
    if limit > MAX_ONCHAIN_MESSAGES { limit = MAX_ONCHAIN_MESSAGES }
    
    let i: u64 = 0
    while i < limit {
        let msg_key: string = MSG_PREFIX + caller.to_string() + "_" + i.to_string(10u32)
        let msg_opt: optional<string> = s.load(msg_key)
        if msg_opt.is_some() {
            let msg_data: string = msg_opt.expect("err")
            let parts: string[] = msg_data.split("|")
            if parts.len() > 1 {
                let sender: Address = Address::from_string(parts[1]).expect("err")
                if sender == peer {
                    s.store(msg_key, "DELETED|" + peer.to_string() + "|0")
                }
            }
        }
        i += 1
    }
    
    // Mark conversation as deleted
    s.store(CONV_DELETED_PREFIX + caller.to_string() + "_" + peer.to_string(), true)
    
    return 0
}

// Check if a message has been deleted
pub fn is_message_deleted(recipient: Address, slot: u64) -> bool {
    return Storage::new().load(MSG_DELETED_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)).unwrap_or(false)
}

// ============================================================================
// v7.0: GROUP ADMIN FEATURES
// ============================================================================

const GROUP_ADMIN_PREFIX: string = "ga_"

// Set a new group admin (only current admin can do this)
entry set_group_admin(group_id: u64, new_admin: Address) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("gnf")
    require(group.creator == caller, "notadmin")
    
    // Store admin override (if different from creator)
    s.store(GROUP_ADMIN_PREFIX + group_id.to_string(10u32), new_admin)
    
    return 0
}

// Admin delete a message in a group (group admin only)
entry admin_delete_group_message(group_id: u64, msg_slot: u64) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("gnf")
    
    // Check if caller is admin (creator or designated admin)
    let admin_opt: optional<Address> = s.load(GROUP_ADMIN_PREFIX + group_id.to_string(10u32))
    let is_admin: bool = false
    if caller == group.creator { is_admin = true }
    if admin_opt.is_some() {
        if caller == admin_opt.expect("err") { is_admin = true }
    }
    require(is_admin, "notadmin")
    
    // Delete the message (tombstone)
    let msg_key: string = MSG_PREFIX + "group_" + group_id.to_string(10u32) + "_" + msg_slot.to_string(10u32)
    s.store(msg_key, "DELETED|admin|0")
    
    return 0
}

// Admin kick member from group (removes their encrypted key + marks as removed)
entry admin_kick_member(group_id: u64, member: Address) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("gnf")
    
    let admin_opt: optional<Address> = s.load(GROUP_ADMIN_PREFIX + group_id.to_string(10u32))
    let is_admin: bool = false
    if caller == group.creator { is_admin = true }
    if admin_opt.is_some() {
        if caller == admin_opt.expect("err") { is_admin = true }
    }
    require(is_admin, "notadmin")
    
    // Remove their encrypted group key
    let key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + member.to_string()
    s.delete(key)
    
    // Decrement member count
    let count_key: string = GROUP_MEMBERS_COUNT_PREFIX + group_id.to_string(10u32)
    let count: u64 = s.load(count_key).unwrap_or(0)
    if count > 0 { s.store(count_key, count - 1) }
    
    return 0
}

// Store a group message on-chain (for group chat persistence)
entry store_group_message(
    group_id: u64,
    encrypted_blob: bytes,
    timestamp: u64
) -> u64 {
    when_not_paused()
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let sender: Address = caller
    // Verify caller is a member of the group
    let member_key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + caller.to_string()
    let is_member: bool = s.load(member_key).unwrap_or(false)
    require(is_member, "notmember")
    
    let count_key: string = MSG_COUNT_PREFIX + "group_" + group_id.to_string(10u32)
    let count: u64 = s.load(count_key).unwrap_or(0)
    let slot: u64 = count % MAX_ONCHAIN_MESSAGES
    let msg_key: string = MSG_PREFIX + "group_" + group_id.to_string(10u32) + "_" + slot.to_string(10u32)
    
    let msg_data: string = encrypted_blob.to_hex() + "|" + sender.to_string() + "|" + timestamp.to_string(10u32)
    s.store(msg_key, msg_data)
    s.store(count_key, count + 1)
    
    return count
}

// Get a group message from on-chain storage
pub fn get_group_message(group_id: u64, index: u64) -> string {
    let s: Storage = Storage::new()
    let msg_key: string = MSG_PREFIX + "group_" + group_id.to_string(10u32) + "_" + index.to_string(10u32)
    let msg_opt: optional<string> = s.load(msg_key)
    if msg_opt.is_none() { return "" }
    return msg_opt.expect("err")
}

// Get group message count
pub fn get_group_message_count(group_id: u64) -> u64 {
    return Storage::new().load(MSG_COUNT_PREFIX + "group_" + group_id.to_string(10u32)).unwrap_or(0)
}


// ============================================================================
// v7.1: PREMIUM MESSAGE PAYMENT SYSTEM
// ----------------------------------------------------------------------------
// Relayers set their own pricing. Users pay in VLT (preferred) or XEL.
// First 100 messages/day are FREE (enforced on-chain).
// Relayer earns the premium payment.
// ============================================================================

const FREE_DAILY_LIMIT: u64 = 100
const DAILY_COUNT_PREFIX: string = "dcount_"
const DAILY_DATE_PREFIX: string = "ddate_"
const RELAYER_FEE_PREFIX: string = "rfee_"
const RELAYER_TOKEN_PREFIX: string = "rtok_"
const VLT_ASSET_KEY: string = "va"

// Relayer sets their own fee per premium message (in atomic units)
// token: 0 = VLT, 1 = XEL
entry set_relayer_fee(fee_amount: u64, token: u8) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let is_relayer: bool = s.load(RELAYER_PREFIX + caller.to_string()).unwrap_or(false)
    require(is_relayer, "notrelayer")
    require(token <= 1, "badtoken")
    require(fee_amount <= 100000000, "badfee")  // max 1 VLT/XEL per message
    s.store(RELAYER_FEE_PREFIX + caller.to_string(), fee_amount)
    s.store(RELAYER_TOKEN_PREFIX + caller.to_string(), token)
    return 0
}

// Get a relayer's fee
pub fn get_relayer_fee(relayer: Address) -> (u64, u8) {
    let s: Storage = Storage::new()
    return (
        s.load(RELAYER_FEE_PREFIX + relayer.to_string()).unwrap_or(1000000),  // default 0.01 VLT
        s.load(RELAYER_TOKEN_PREFIX + relayer.to_string()).unwrap_or(0)
    )
}

// Check how many free messages a user has left today
pub fn get_free_messages_remaining(user: Address) -> u64 {
    let s: Storage = Storage::new()
    let today: u64 = get_current_topoheight() / 17280  // day number
    let stored_day: u64 = s.load(DAILY_DATE_PREFIX + user.to_string()).unwrap_or(0)
    if stored_day != today { return FREE_DAILY_LIMIT }
    let count: u64 = s.load(DAILY_COUNT_PREFIX + user.to_string()).unwrap_or(0)
    if count >= FREE_DAILY_LIMIT { return 0 }
    return FREE_DAILY_LIMIT - count
}

// Increment daily message count (called by store_message)
fn increment_daily_count(user: Address) {
    let s: Storage = Storage::new()
    let today: u64 = get_current_topoheight() / 17280
    let stored_day: u64 = s.load(DAILY_DATE_PREFIX + user.to_string()).unwrap_or(0)
    if stored_day != today {
        s.store(DAILY_DATE_PREFIX + user.to_string(), today)
        s.store(DAILY_COUNT_PREFIX + user.to_string(), 1u64)
    } else {
        let count: u64 = s.load(DAILY_COUNT_PREFIX + user.to_string()).unwrap_or(0)
        s.store(DAILY_COUNT_PREFIX + user.to_string(), count + 1)
    }
}

// Pay for a premium message (called when free limit is exceeded)
// Payment goes to the relayer who processes the message
entry pay_premium_message(relayer: Address) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    
    // Verify caller has exceeded free limit
    let remaining: u64 = get_free_messages_remaining(caller)
    require(remaining == 0, "stillfree")
    
    // Verify relayer is authorized
    let is_relayer: bool = s.load(RELAYER_PREFIX + relayer.to_string()).unwrap_or(false)
    require(is_relayer, "notrelayer")
    
    // Get relayer fee
    let fee: u64 = s.load(RELAYER_FEE_PREFIX + relayer.to_string()).unwrap_or(1000000)
    let token: u8 = s.load(RELAYER_TOKEN_PREFIX + relayer.to_string()).unwrap_or(0)
    
    // Transfer payment to relayer
    if token == 0 {
        // VLT payment
        let vlt_asset: Hash = s.load(VLT_ASSET_KEY).unwrap_or(Hash::zero())
        if vlt_asset != Hash::zero() {
            let ok: bool = transfer(relayer, fee, vlt_asset)
            require(ok, "vltfail")
        }
    } else {
        // XEL payment (native)
        let ok: bool = transfer(relayer, fee, Hash::zero())
        require(ok, "xelfail")
    }
    
    // Grant 1 premium message credit (resets on next store_message)
    let today: u64 = get_current_topoheight() / 17280
    let count: u64 = s.load(DAILY_COUNT_PREFIX + caller.to_string()).unwrap_or(0)
    s.store(DAILY_COUNT_PREFIX + caller.to_string(), count - 1)  // decrement to give 1 free slot
    
    return 0
}

// Relayer claims their accumulated fees (if any held in contract)
entry claim_relayer_fees() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let is_relayer: bool = s.load(RELAYER_PREFIX + caller.to_string()).unwrap_or(false)
    require(is_relayer, "notrelayer")
    
    // Transfer all VLT balance to relayer
    let vlt_asset: Hash = s.load(VLT_ASSET_KEY).unwrap_or(Hash::zero())
    if vlt_asset != Hash::zero() {
        let bal: u64 = get_balance_for_asset(vlt_asset).unwrap_or(0)
        if bal > 0 { transfer(caller, bal, vlt_asset) }
    }
    
    // Transfer all XEL balance to relayer
    let xel_bal: u64 = get_balance_for_asset(Hash::zero()).unwrap_or(0)
    if xel_bal > 0 { transfer(caller, xel_bal, Hash::zero()) }
    
    return 0
}

// ============================================================================
// v7.2: KEY ROTATION + READ RECEIPTS + EPHEMERAL MESSAGES
// ============================================================================

const GROUP_KEY_VERSION_PREFIX: string = "gkv_"
const READ_RECEIPT_PREFIX: string = "rr_"
const EPHEMERAL_PREFIX: string = "eph_"
const EPHEMERAL_DEFAULT_BLOCKS: u64 = 43200  // ~6 hours

// ── KEY ROTATION: when admin kicks a member, rotate the group key ──────────

// Rotate group key after kicking a member (admin only)
// Generates a new key version and requires all remaining members to get new keys
entry rotate_group_key(group_id: u64, new_group_pubkey: Hash) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("gnf")
    
    // Verify admin
    let admin_opt: optional<Address> = s.load(GROUP_ADMIN_PREFIX + group_id.to_string(10u32))
    let is_admin: bool = false
    if caller == group.creator { is_admin = true }
    if admin_opt.is_some() { if caller == admin_opt.expect("err") { is_admin = true } }
    require(is_admin, "notadmin")
    
    // Increment key version
    let version_key: string = GROUP_KEY_VERSION_PREFIX + group_id.to_string(10u32)
    let old_version: u64 = s.load(version_key).unwrap_or(0)
    s.store(version_key, old_version + 1)
    
    // Update group public key
    group.group_pubkey = new_group_pubkey
    s.store(GROUP_PREFIX + group_id.to_string(10u32), group)
    
    return old_version + 1
}

// Get current key version for a group (members check this to know if they need new keys)
pub fn get_group_key_version(group_id: u64) -> u64 {
    return Storage::new().load(GROUP_KEY_VERSION_PREFIX + group_id.to_string(10u32)).unwrap_or(0)
}

// Distribute new encrypted key to a member after rotation (admin only)
entry distribute_new_key(group_id: u64, member: Address, new_encrypted_key: bytes) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let group: Group = s.load(GROUP_PREFIX + group_id.to_string(10u32)).expect("gnf")
    
    let admin_opt: optional<Address> = s.load(GROUP_ADMIN_PREFIX + group_id.to_string(10u32))
    let is_admin: bool = false
    if caller == group.creator { is_admin = true }
    if admin_opt.is_some() { if caller == admin_opt.expect("err") { is_admin = true } }
    require(is_admin, "notadmin")
    
    // Store new key for member
    let key: string = GROUP_MEMBER_PREFIX + group_id.to_string(10u32) + "_" + member.to_string()
    s.store(key, new_encrypted_key)
    
    return 0
}

// ── READ RECEIPTS ───────────────────────────────────────────────────────────

// Mark a message as read (only recipient can do this)
entry mark_read(recipient: Address, slot: u64) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    require(caller == recipient, "notrecipient")
    s.store(READ_RECEIPT_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32), get_current_topoheight())
    return 0
}

// Check if a message has been read
pub fn is_message_read(recipient: Address, slot: u64) -> bool {
    let topo: u64 = Storage::new().load(READ_RECEIPT_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)).unwrap_or(0)
    return topo > 0
}

// Get read timestamp
pub fn get_read_timestamp(recipient: Address, slot: u64) -> u64 {
    return Storage::new().load(READ_RECEIPT_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)).unwrap_or(0)
}

// ── EPHEMERAL MESSAGES (auto-delete after N blocks) ─────────────────────────

// Store an ephemeral message that auto-expires
entry store_ephemeral_message(
    recipient: Address,
    encrypted_blob: bytes,
    timestamp: u64,
    ttl_blocks: u64
) -> u64 {
    when_not_paused()
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    
    let count_key: string = MSG_COUNT_PREFIX + recipient.to_string()
    let count: u64 = s.load(count_key).unwrap_or(0)
    let slot: u64 = count % MAX_ONCHAIN_MESSAGES
    let msg_key: string = MSG_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)
    
    let msg_data: string = encrypted_blob.to_hex() + "|" + caller.to_string() + "|" + timestamp.to_string(10u32)
    s.store(msg_key, msg_data)
    s.store(count_key, count + 1)
    
    // Store expiration topoheight
    let expire_topo: u64 = get_current_topoheight() + ttl_blocks
    s.store(EPHEMERAL_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32), expire_topo)
    
    return count
}

// Check if an ephemeral message has expired
pub fn is_expired(recipient: Address, slot: u64) -> bool {
    let s: Storage = Storage::new()
    let expire_key: string = EPHEMERAL_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)
    let expire_opt: optional<u64> = s.load(expire_key)
    if expire_opt.is_none() { return false }
    let expire_topo: u64 = expire_opt.expect("err")
    return get_current_topoheight() >= expire_topo
}

// Get expiration topoheight for a message (0 = not ephemeral)
pub fn get_expiration(recipient: Address, slot: u64) -> u64 {
    return Storage::new().load(EPHEMERAL_PREFIX + recipient.to_string() + "_" + slot.to_string(10u32)).unwrap_or(0)
}

// ============================================================================
// v7.3: RELAY SUBSCRIPTION TIER + RELAYER REPUTATION
// ============================================================================

const RELAY_SUB_PREFIX: string = "rsub_"
const RELAY_STATS_PREFIX: string = "rstat_"
const RELAY_SUB_DEFAULT_BLOCKS: u64 = 2592000  // ~30 days

// ── Relay Subscription: user pays for unlimited messages for N days ────────

// User buys a subscription from a specific relayer
// Payment goes directly to the relayer
entry buy_subscription(relayer: Address, duration_blocks: u64) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    
    // Verify relayer is authorized
    let is_relayer: bool = s.load(RELAYER_PREFIX + relayer.to_string()).unwrap_or(false)
    require(is_relayer, "notrelayer")
    
    // Get relayer's per-message fee (subscription = 100x per-message fee)
    let fee: u64 = s.load(RELAYER_FEE_PREFIX + relayer.to_string()).unwrap_or(1000000)
    let token: u8 = s.load(RELAYER_TOKEN_PREFIX + relayer.to_string()).unwrap_or(0)
    let sub_price: u64 = fee * 100  // 100 messages worth = 30 days unlimited
    
    // Default duration
    if duration_blocks == 0 { duration_blocks = RELAY_SUB_DEFAULT_BLOCKS }
    
    // Transfer payment to relayer
    if token == 0 {
        let vlt_asset: Hash = s.load(VLT_ASSET_KEY).unwrap_or(Hash::zero())
        if vlt_asset != Hash::zero() {
            let ok: bool = transfer(relayer, sub_price, vlt_asset)
            require(ok, "vltfail")
        }
    } else {
        let ok: bool = transfer(relayer, sub_price, Hash::zero())
        require(ok, "xelfail")
    }
    
    // Store subscription expiry
    let expiry: u64 = get_current_topoheight() + duration_blocks
    s.store(RELAY_SUB_PREFIX + caller.to_string(), expiry)
    
    // Update relayer stats
    let stats_key: string = RELAY_STATS_PREFIX + relayer.to_string()
    let stats: u64 = s.load(stats_key).unwrap_or(0)
    s.store(stats_key, stats + 1)
    
    return expiry
}

// Check if user has an active subscription
pub fn has_subscription(user: Address) -> bool {
    let s: Storage = Storage::new()
    let expiry: u64 = s.load(RELAY_SUB_PREFIX + user.to_string()).unwrap_or(0)
    return get_current_topoheight() < expiry
}

// Get subscription expiry topoheight
pub fn get_subscription_expiry(user: Address) -> u64 {
    return Storage::new().load(RELAY_SUB_PREFIX + user.to_string()).unwrap_or(0)
}

// ── Relayer Reputation (on-chain, public) ──────────────────────────────────

const RELAY_REP_PREFIX: string = "rrep_"
const RELAY_HEARTBEAT_PREFIX: string = "rhb_"
const RELAY_HEARTBEAT_INTERVAL: u64 = 100
const RELAY_HEARTBEAT_TIMEOUT: u64 = 300

// Relayer submits heartbeat (proves they're online)
entry relayer_heartbeat() -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    let is_relayer: bool = s.load(RELAYER_PREFIX + caller.to_string()).unwrap_or(false)
    require(is_relayer, "notrelayer")
    
    let last_hb: u64 = s.load(RELAY_HEARTBEAT_PREFIX + caller.to_string()).unwrap_or(0)
    let now: u64 = get_current_topoheight()
    require(now >= last_hb + RELAY_HEARTBEAT_INTERVAL, "toosoon")
    
    s.store(RELAY_HEARTBEAT_PREFIX + caller.to_string(), now)
    
    // Increment reputation for being online
    let rep: u64 = s.load(RELAY_REP_PREFIX + caller.to_string()).unwrap_or(0)
    s.store(RELAY_REP_PREFIX + caller.to_string(), rep + 1)
    
    return 0
}

// Check if relayer is online (heartbeat within timeout)
pub fn is_relayer_online(relayer: Address) -> bool {
    let s: Storage = Storage::new()
    let last_hb: u64 = s.load(RELAY_HEARTBEAT_PREFIX + relayer.to_string()).unwrap_or(0)
    if last_hb == 0 { return false }
    let now: u64 = get_current_topoheight()
    if now > last_hb + RELAY_HEARTBEAT_TIMEOUT { return false }
    return true
}

// Get relayer reputation score
pub fn get_relayer_reputation(relayer: Address) -> u64 {
    return Storage::new().load(RELAY_REP_PREFIX + relayer.to_string()).unwrap_or(0)
}

// Get relayer stats (messages relayed, subscriptions sold)
pub fn get_relayer_stats(relayer: Address) -> (u64, u64) {
    let s: Storage = Storage::new()
    return (
        s.load(RELAY_STATS_PREFIX + relayer.to_string()).unwrap_or(0),  // subscriptions
        s.load(RELAY_REP_PREFIX + relayer.to_string()).unwrap_or(0)     // reputation
    )
}

// Rate a relayer (users can rate after using their service)
const RELAY_RATING_PREFIX: string = "rrat_"
const RELAY_RATING_COUNT_PREFIX: string = "rrc_"

entry rate_relayer(relayer: Address, rating: u8) -> u64 {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("err")
    require(rating >= 1 && rating <= 5, "badrating")
    
    // Prevent double rating
    let rated_key: string = RELAY_RATING_PREFIX + relayer.to_string() + "_" + caller.to_string()
    let already: bool = s.load(rated_key).unwrap_or(false)
    require(!already, "alreadyrated")
    
    s.store(rated_key, true)
    
    // Update rating sum and count
    let count_key: string = RELAY_RATING_COUNT_PREFIX + relayer.to_string()
    let current_count: u64 = s.load(count_key + "_c").unwrap_or(0)
    let current_sum: u64 = s.load(count_key + "_s").unwrap_or(0)
    s.store(count_key + "_c", current_count + 1)
    s.store(count_key + "_s", current_sum + rating as u64)
    
    return 0
}

// Get relayer average rating
pub fn get_relayer_rating(relayer: Address) -> u64 {
    let s: Storage = Storage::new()
    let count: u64 = s.load(RELAY_RATING_COUNT_PREFIX + relayer.to_string() + "_c").unwrap_or(0)
    if count == 0 { return 0 }
    let sum: u64 = s.load(RELAY_RATING_COUNT_PREFIX + relayer.to_string() + "_s").unwrap_or(0)
    return (sum * 100 / count)  // returns rating * 100 (e.g. 450 = 4.50)
}
