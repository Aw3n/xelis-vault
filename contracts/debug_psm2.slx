hook constructor() -> u64 { return 0 }

entry config(h: Hash) -> u64 {
    Storage::new().store("h", h);
    return 0
}

entry psm_mint(xel_amount: u64, min_xusd_out: u64) -> u64 {
    let oh: Hash = Storage::new().load("h").expect("hns")
    let oc: Contract = Contract::new(oh).expect("ocnf")
    let price: u64 = oc.call(3u16, [Hash::zero()], {})
    require(price > 0, "noprice")

    let caller: Address = get_caller().expect("nocaller")
    let dep: u64 = get_deposit_for_asset(Hash::zero()).expect("insdep")
    require(dep >= xel_amount, "insdep")

    let xc: Contract = Contract::new(Hash::from_hex("5d4a8d533068de04969adc381bad8728a19f6d0b34e715cca3d9dfe09a568b6a")).expect("xcnf")
    let _: u64 = xc.call(26u16, [min_xusd_out], {})
    return 0
}
