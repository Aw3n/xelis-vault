hook constructor() -> u64 {
    Storage::new().store("h", Hash::from_hex("147ab6aa686a5268396b39bc7d78de7e9e913dd6df7d0ae145a7eef28f163f2a"))
    return 0
}

entry test() -> u64 {
    let oh: Hash = Storage::new().load("h").expect("hns")
    let oc: Contract = Contract::new(oh).expect("ocnf")
    let price: u64 = oc.call(3u16, [Hash::zero()], {})
    return price
}
