// ID 29: set_emergency
entry set_emergency(addr: Address) -> u64 {
    only_emergency();
    Storage::new().store(EMERGENCY_KEY, addr);
    return 0;
}

// ID 30: request_emergency_withdraw
entry request_emergency_withdraw() -> u64 {
    only_emergency();
    Storage::new().store(EMERGENCY_REQUEST_TOPO_KEY, get_current_topoheight());
    return 0;
}

// ID 31: execute_emergency_withdraw
entry execute_emergency_withdraw(asset: Hash) -> u64 {
    let s: Storage = Storage::new();
    let caller: Address = get_caller().expect("nocaller");
    let e: Address = s.load(EMERGENCY_KEY).expect("easet");
    require(caller == e, "notemg");
    let req_topo: u64 = s.load(EMERGENCY_REQUEST_TOPO_KEY).unwrap_or(0);
    require(req_topo > 0, "norequest");
    let now_topo: u64 = get_current_topoheight();
    require(now_topo >= req_topo + EMERGENCY_DELAY_BLOCKS, "toosoon");
    s.delete(EMERGENCY_REQUEST_TOPO_KEY);
    let bal: u64 = get_balance_for_asset(asset).expect("nobalance");
    if bal > 0 {
        let _ = transfer(caller, bal, asset);
    }
    return 0;
}

// ID 32: get_pool
entry get_pool(pool_id: u64) -> optional<Pool> {
    return Storage::new().load(get_pool_key(pool_id));
}

// ID 33: get_reserves
entry get_reserves(pool_id: u64) -> (Hash, Hash, u64, u64) {
    let pool: Pool = Storage::new().load(get_pool_key(pool_id)).expect("pnf");
    return (pool.token_a, pool.token_b, pool.reserve_a, pool.reserve_b);
}

// ID 34: get_pair
entry get_pair(token_a: Hash, token_b: Hash) -> optional<u64> {
    return load_pair(token_a, token_b);
}

// ID 35: get_pools_count
entry get_pools_count() -> u64 {
    return Storage::new().load(POOL_COUNT_KEY).unwrap_or(0);
}

// ID 36: get_config
entry get_config() -> (u64, u64, u64, u64, u64, u64, optional<Address>) {
    let s: Storage = Storage::new();
    return (
        s.load(FEE_SWAP_KEY).unwrap_or(DEFAULT_SWAP_FEE),
        s.load(FEE_TREASURY_KEY).unwrap_or(DEFAULT_TREASURY_FEE),
        s.load(FEE_PSM_MINT_KEY).unwrap_or(DEFAULT_PSM_MINT_FEE),
        s.load(FEE_PSM_REDEEM_KEY).unwrap_or(DEFAULT_PSM_REDEEM_FEE),
        s.load(MAX_VOLATILITY_BPS_KEY).unwrap_or(DEFAULT_MAX_VOLATILITY_BPS),
        s.load(MAX_SWAP_PCT_BPS_KEY).unwrap_or(DEFAULT_MAX_SWAP_PCT),
        s.load(TREASURY_KEY)
    );
}

// ID 37: get_amount_out
entry get_amount_out_entry(asset_in: Hash, asset_out: Hash, amount_in: u64) -> u64 {
    let pool_id_opt: optional<u64> = load_pair(asset_in, asset_out);
    if pool_id_opt.is_none() { return 0; }
    let pool: Pool = Storage::new().load(get_pool_key(pool_id_opt.unwrap())).expect("pnf");
    let is_a_to_b: bool = (asset_in == pool.token_a);
    let reserve_in: u64 = is_a_to_b ? pool.reserve_a : pool.reserve_b;
    let reserve_out: u64 = is_a_to_b ? pool.reserve_b : pool.reserve_a;
    let fee_bps: u64 = Storage::new().load(FEE_SWAP_KEY).unwrap_or(DEFAULT_SWAP_FEE);
    return get_amount_out(amount_in, reserve_in, reserve_out, fee_bps);
}

// ID 38: get_twap
entry get_twap(asset_a: Hash, asset_b: Hash) -> u64 {
    return twap_get(get_pair_key(asset_a, asset_b));
}

// ID 39: get_volatility
entry get_volatility(asset_a: Hash, asset_b: Hash) -> u64 {
    return twap_volatility_bps(get_pair_key(asset_a, asset_b));
}
