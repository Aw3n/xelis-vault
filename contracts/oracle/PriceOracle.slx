const VERSION: string = "PriceOracle v2.0"

const ADMIN_KEY: string = "a"
const PRICE_KEY: string = "p"
const PENDING_PRICE_KEY: string = "pp"
const PENDING_TOPO_KEY: string = "pt"
const TIMELOCK_KEY: string = "tl"
const TIMELOCK_BLOCKS: u64 = 3
const MINER_CONTRACT_KEY: string = "mc"
const SERVICE_ID: u8 = 1

hook constructor() -> u64 {
    let s: Storage = Storage::new()
    s.store(ADMIN_KEY, get_caller().expect("nocaller"))
    s.store(PRICE_KEY, 0u64)
    s.store(PENDING_PRICE_KEY, 0u64)
    s.store(PENDING_TOPO_KEY, 0u64)
    s.store(TIMELOCK_KEY, TIMELOCK_BLOCKS)
    return 0
}

fn only_admin() {
    let s: Storage = Storage::new()
    let caller: Address = get_caller().expect("nocaller")
    let admin: Address = s.load(ADMIN_KEY).expect("anset")
    require(caller == admin, "notauth")
}

entry propose_price(price: u64) -> u64 {
    only_admin()
    require(price > 0, "zeroprice")
    let s: Storage = Storage::new()
    s.store(PENDING_PRICE_KEY, price)
    s.store(PENDING_TOPO_KEY, get_current_topoheight())
    return 0
}

entry execute_price() -> u64 {
    let s: Storage = Storage::new()
    let pending: u64 = s.load(PENDING_PRICE_KEY).unwrap_or(0)
    require(pending > 0, "nopending")
    let proposed_topo: u64 = s.load(PENDING_TOPO_KEY).unwrap_or(0)
    let delay: u64 = s.load(TIMELOCK_KEY).unwrap_or(TIMELOCK_BLOCKS)
    require(get_current_topoheight() >= proposed_topo + delay, "toosoon")
    s.store(PRICE_KEY, pending)
    s.store(PENDING_PRICE_KEY, 0u64)
    s.store(PENDING_TOPO_KEY, 0u64)

    let mc_opt: optional<Hash> = s.load(MINER_CONTRACT_KEY)
    if mc_opt.is_some() {
        let mc: Hash = mc_opt.expect("err")
        let caller: Address = get_caller().expect("nocaller")
        let miner_contract: Contract = Contract::new(mc).expect("err")
        let _ = miner_contract.call(18u16, [caller, SERVICE_ID, true], {})
    }
    return 0
}

pub fn get_price(asset: Hash) -> u64 {
    let price: u64 = Storage::new().load(PRICE_KEY).unwrap_or(0)
    require(price > 0, "noprice")
    return price
}

entry get_price_entry(asset: Hash) -> u64 {
    let price: u64 = Storage::new().load(PRICE_KEY).unwrap_or(0)
    require(price > 0, "noprice")
    return price
}

entry cancel_pending() -> u64 {
    only_admin()
    let s: Storage = Storage::new()
    s.store(PENDING_PRICE_KEY, 0u64)
    s.store(PENDING_TOPO_KEY, 0u64)
    return 0
}

entry set_miner_contract(mc: Hash) -> u64 {
    only_admin()
    Storage::new().store(MINER_CONTRACT_KEY, mc)
    return 0
}

entry set_timelock_blocks(blocks: u64) -> u64 {
    only_admin()
    require(blocks > 0, "zeroblocks")
    Storage::new().store(TIMELOCK_KEY, blocks)
    return 0
}

entry transfer_admin(new_admin: Address) -> u64 {
    only_admin()
    Storage::new().store(ADMIN_KEY, new_admin)
    return 0
}

entry get_version() -> string {
    return VERSION
}
