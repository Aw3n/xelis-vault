printf "${DIM}──────────────────────────────────────────────────────────────────${RESET}\n"
printf "\n"
printf "${GREEN}${BOLD}Happy mining!${RESET}\n"
printf "${DIM}  Note: This installer has collected NO telemetry.${RESET}\n"
printf "${DIM}  No data leaves your machine.${RESET}\n"
printf "\n"
