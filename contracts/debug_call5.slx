hook constructor() -> u64 {
    let s: Storage = Storage::new()
    s.store("h1", Hash::from_hex("147ab6aa686a5268396b39bc7d78de7e9e913dd6df7d0ae145a7eef28f163f2a"))
    s.store("h2", Hash::from_hex("f7bd8984eac7706103cef3d8dca938c9bd92d1bb9c77c1057740ac6a817cf0a7"))
    s.store("h3", Hash::from_hex("5d4a8d533068de04969adc381bad8728a19f6d0b34e715cca3d9dfe09a568b6a"))
    return 0
}

entry test_psm(xel_amount: u64, min_xusd_out: u64) -> u64 {
    require(xel_amount > 0, "amtgt0")
    require(min_xusd_out > 0, "noslippage")

    let s: Storage = Storage::new()
    let xa: Hash = s.load("h2").expect("xa")
    let oh: Hash = s.load("h1").expect("oc")
    let oc: Contract = Contract::new(oh).expect("ocnf")
    let price: u64 = oc.call(3u16, [Hash::zero()], {})
    require(price > 0, "noprice")

    let gross_xusd: u64 = xel_amount * price / 100000000
    let net_xusd: u64 = gross_xusd - (gross_xusd * 50 / 10000)
    require(net_xusd >= min_xusd_out, "slippage")

    return price
}
