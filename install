#!/usr/bin/env bash
# ============================================================================
#  XELIS Vault — All-in-One Installer
# ============================================================================
#  Install : curl -fsSL https://xelisvault.github.io/install | bash
#  Update  : curl -fsSL https://xelisvault.github.io/install | bash
#  Uninstall : curl -fsSL https://xelisvault.github.io/install | bash -s -- --uninstall
# ============================================================================
set -euo pipefail

# ── Colors & helpers ─────────────────────────────────────────────────────────
if [[ -t 1 ]] && command -v tput &>/dev/null; then
    BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
    RED=$(tput setaf 1); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4); MAGENTA=$(tput setaf 5); CYAN=$(tput setaf 6)
    WHITE=$(tput setaf 7); GRAY=$(tput setaf 8)
else
    BOLD=""; DIM=""; RESET=""; RED=""; GREEN=""; YELLOW=""; BLUE=""
    MAGENTA=""; CYAN=""; WHITE=""; GRAY=""
fi

BANNER="${CYAN}${BOLD}"
BANNER+=" ██████  ██      ██   ██ ██ ███████  ██████ ████████ ██  ██████  ███    ██\n"
BANNER+="██    ██ ██      ██  ██  ██ ██      ██         ██    ██ ██    ██ ████   ██\n"
BANNER+="██    ██ ██      █████   ██ █████   ██         ██    ██ ██    ██ ██ ██  ██\n"
BANNER+="██    ██ ██      ██  ██  ██ ██      ██         ██    ██ ██    ██ ██  ██ ██\n"
BANNER+=" ██████  ███████ ██   ██ ██ ███████  ██████    ██    ██  ██████  ██   ████\n"
BANNER+="${RESET}\n"
BANNER+="${DIM}              Privacy-First DeFi on XELIS BlockDAG${RESET}\n"

info()    { printf "${BLUE}i${RESET}  %s\n" "$*"; }
success() { printf "${GREEN}v${RESET}  %s\n" "$*"; }
warn()    { printf "${YELLOW}!${RESET}  %s\n" "$*"; }
error()   { printf "${RED}x${RESET}  %s\n" "$*" >&2; }
step()    { printf "\n${MAGENTA}${BOLD}> %s${RESET}\n" "$*"; }
prompt()  { printf "${CYAN}?${RESET}  %s " "$*"; }

# ── Config ────────────────────────────────────────────────────────────────────
REPO="XelisVault/xelis-vault"
REPO_URL="https://github.com/${REPO}.git"
INSTALL_DIR="${HOME}/.xelis-vault"
BIN_DIR="${HOME}/.local/bin"
VENV_DIR="${INSTALL_DIR}/venv"
CONFIG_DIR="${INSTALL_DIR}/config"
LOGS_DIR="${INSTALL_DIR}/logs"
XELIS_DIR="${INSTALL_DIR}/xelis-bin"
WALLET_DIR="${INSTALL_DIR}/wallet"
VERSION="5.2"

FORCE=0
UNINSTALL=0
INTERACTIVE=1
SKIP_DEPS=0
SKIP_XELIS=0
SKIP_WALLET=0
SKIP_SERVICE=0

# ── Contract Addresses (testnet) ─────────────────────────────────────────────
CONTRACT_VAULTSWAP="1b6699398e2acecbdd1fd372952696cfc37b99eb1dcac45a7216661f96c60422"
CONTRACT_MINER="21ed1297c7ed4001a4a7c9a4bb89b10da0b0f3ad0312545a5af4a761200af207"
CONTRACT_VLT_TOKEN="7275c55d711789b1b746cd4695b04c0e393a0db74ecf72360c5544b73368cfab"
CONTRACT_VLT_ASSET="2de72ed3ea2d8ff30e6df57ba3a4d993dedfa8636d207d43d09e33615bfde2c6"
CONTRACT_ORACLE="764ad585c2f484e54ea9dd06a7fb8b81397ba2487d37298f27edce3747d836dd"
CONTRACT_PSM="9f2667447b9a850ba4b260c19cd2c3786bc4a3c5559a08332a9e13bfa47191ae"
CONTRACT_GOV_VAULT="830ddfd85eb8ccd44678719cd32633806eba44aa4b455b3785ba04fb3a0b4aa9"
CONTRACT_REGISTRY="32abb6db396e1c341868a97fcbc8cfd4a9219af6311d1a3c2e12fe7474ddc06e"
CONTRACT_STAKED_ORACLE="57a343969a7144546218b8f9d436f086b32e9d4175f9a5af55c5707c3d1e350a"
CONTRACT_ORACLE_GOV="1f5ffe2ab5086202e104cde2517a76738a13391a9e0fd4e3090a65cb7679dbcd"
CONTRACT_XUSD="909576c1fcd889ec443b63a4ce014bf756fcb8afd74c8c0ee902cac03384e3fc"
CONTRACT_XUSD_ASSET="d8bd79a2aa33ad4a6fa0ac2b2440515124445ecce0468e070a8a09bb5ea9442f"
CONTRACT_VAULT_ENGINE="667b165c8c9cd6cc3464378799e38b172e0f2e912f4b5c6202d37a8da3939bcc"
CONTRACT_GOVERNOR="f8a5880d02616085b26fa4d2a5888bf3328d8ab679af1ed0c90d693bff09a119"
CONTRACT_GUARDIAN="4c5783d36173e309fa47c746c37f865accf08c1a4dfee92ba84cc08392326e4a"
CONTRACT_TIMELOCK="bf6c0004993d50d0edc31eb38cebad38aa95e522040c9ea1d48cdea2eb2df597"

# ── Argument parsing ─────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --uninstall)   UNINSTALL=1; shift ;;
        --force|-f)    FORCE=1; shift ;;
        --yes|-y)      INTERACTIVE=0; shift ;;
        --skip-deps)   SKIP_DEPS=1; shift ;;
        --skip-xelis)  SKIP_XELIS=1; shift ;;
        --skip-wallet) SKIP_WALLET=1; shift ;;
        --skip-service)SKIP_SERVICE=1; shift ;;
        --version)     echo "xelis-vault ${VERSION}"; exit 0 ;;
        --help|-h)
            cat <<EOF
${BOLD}XELIS Vault Installer${RESET} v${VERSION}

${BOLD}Usage:${RESET}
  curl -fsSL https://xelisvault.github.io/install | bash

${BOLD}Options:${RESET}
  --uninstall        Remove XELIS Vault from this machine
  --force, -f        Reinstall even if already present
  --yes, -y          Non-interactive mode (CI)
  --skip-deps        Skip system dependency checks
  --skip-xelis       Do not download missing XELIS binaries
  --skip-wallet      Skip wallet setup
  --skip-service     Do not create auto-start service
  --version          Show version
  --help, -h         Show this help

${BOLD}Examples:${RESET}
  # Standard installation (interactive)
  curl -fsSL https://xelisvault.github.io/install | bash

  # Silent installation
  curl -fsSL https://xelisvault.github.io/install | bash -s -- -y

  # Uninstallation
  curl -fsSL https://xelisvault.github.io/install | bash -s -- --uninstall

${BOLD}Documentation:${RESET} https://github.com/${REPO}
${BOLD}Discord:${RESET} https://discord.gg/UHpYAWbG
EOF
            exit 0
            ;;
        *) error "Unknown option: $1"; exit 1 ;;
    esac
done

# ── Uninstall ─────────────────────────────────────────────────────────────────
if [[ $UNINSTALL -eq 1 ]]; then
    printf "\n${BANNER}\n"
    step "Uninstalling XELIS Vault"

    if [[ -d "$INSTALL_DIR" ]]; then
        info "Removing ${INSTALL_DIR}..."
        rm -rf "$INSTALL_DIR"
        success "Installation directory removed"
    else
        warn "XELIS Vault is not installed in ${INSTALL_DIR}"
    fi

    if [[ -L "${BIN_DIR}/xvault" ]] || [[ -f "${BIN_DIR}/xvault" ]]; then
        rm -f "${BIN_DIR}/xvault"
        success "Launcher removed from ${BIN_DIR}"
    fi

    for f in xelis_daemon xelis_wallet xelis_miner; do
        if [[ -L "${BIN_DIR}/${f}" ]]; then
            rm -f "${BIN_DIR}/${f}"
            success "Symlink ${f} removed from ${BIN_DIR}"
        fi
    done

    printf "\n${GREEN}${BOLD}XELIS Vault uninstalled.${RESET}\n\n"
    exit 0
fi

# ── Banner ────────────────────────────────────────────────────────────────────
printf "\n${BANNER}\n"
printf "${DIM}  v${VERSION} — Installer${RESET}\n\n"

# ── Prerequisites check ──────────────────────────────────────────────────────
step "Checking prerequisites"

OS="$(uname -s)"
ARCH="$(uname -m)"
case "$OS" in
    Linux*)  PLATFORM="linux";;
    Darwin*) PLATFORM="macos";;
    *)       error "Unsupported system: $OS (Linux and macOS only)"; exit 1;;
esac
case "$ARCH" in
    x86_64|amd64)   ARCH_TAG="x64";;
    arm64|aarch64)  ARCH_TAG="arm64";;
    *)              error "Unsupported architecture: $ARCH"; exit 1;;
esac
success "Plateforme : ${PLATFORM}-${ARCH_TAG}"

if [[ $SKIP_DEPS -eq 0 ]]; then
    # Python
    if ! command -v python3 &>/dev/null; then
        error "Python 3 is required but not found."
        error "Install it: sudo apt install python3 python3-venv python3-pip (Linux)"
        error "  or: brew install python (macOS)"
        exit 1
    fi
    PY_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
    PY_MAJOR=$(echo "$PY_VERSION" | cut -d. -f1)
    PY_MINOR=$(echo "$PY_VERSION" | cut -d. -f2)
    if [[ $PY_MAJOR -lt 3 ]] || ([[ $PY_MAJOR -eq 3 ]] && [[ $PY_MINOR -lt 10 ]]); then
        error "Python 3.10+ required (found ${PY_VERSION})"
        exit 1
    fi
    success "Python ${PY_VERSION}"

    # Git
    if ! command -v git &>/dev/null; then
        error "git is required but not found."
        error "Install it: sudo apt install git (Linux) or brew install git (macOS)"
        exit 1
    fi
    success "git $(git --version | awk '{print $3}')"

    # Curl
    if ! command -v curl &>/dev/null; then
        error "curl is required but not found."
        error "Install it: sudo apt install curl (Linux) or brew install curl (macOS)"
        exit 1
    fi
    success "curl"

    # xxd
    if ! command -v xxd &>/dev/null; then
        warn "xxd (vim-common) is recommended for hex debugging"
        warn "  Install it: sudo apt install xxd (Linux) or brew install xxd (macOS)"
    else
        success "xxd"
    fi
fi

# ── XELIS binaries check ─────────────────────────────────────────────────────
step "Checking XELIS binaries"

XELIS_BINS=("xelis_daemon" "xelis_wallet" "xelis_miner")
XELIS_MISSING=()
XELIS_FOUND=()

for bin in "${XELIS_BINS[@]}"; do
    found=0
    if command -v "$bin" &>/dev/null; then
        found=1
    else
        for d in "$XELIS_DIR" "${HOME}/xelis" "/usr/local/bin" "/usr/bin" "${HOME}/.local/bin"; do
            if [[ -x "$d/$bin" ]]; then
                found=1
                break
            fi
        done
    fi
    if [[ $found -eq 1 ]]; then
        version_str=""
        if command -v "$bin" &>/dev/null; then
            version_str=$("$bin" --version 2>/dev/null | head -1 || true)
        else
            for d in "$XELIS_DIR" "${HOME}/xelis" "/usr/local/bin" "/usr/bin" "${HOME}/.local/bin"; do
                if [[ -x "$d/$bin" ]]; then
                    version_str=$("$d/$bin" --version 2>/dev/null | head -1 || true)
                    break
                fi
            done
        fi
        success "${bin} found — ${version_str:-unknown version}"
        XELIS_FOUND+=("$bin")
    else
        warn "${bin} not found"
        XELIS_MISSING+=("$bin")
    fi
done

if [[ ${#XELIS_MISSING[@]} -gt 0 ]] && [[ $SKIP_XELIS -eq 0 ]]; then
    step "Downloading missing XELIS binaries"
    echo ""
    info "The following binaries are missing: ${XELIS_MISSING[*]}"
    echo ""
    if [[ $INTERACTIVE -eq 1 ]]; then
        prompt "Download them automatically from GitHub? [Y/n]"
        read -r DL_ANSWER
        DL_ANSWER="${DL_ANSWER:-Y}"
    else
        DL_ANSWER="Y"
    fi

    if [[ "$DL_ANSWER" =~ ^[OoYy]$ ]]; then
        mkdir -p "$XELIS_DIR"

        XELIS_REPO="xelis-project/xelis-blockchain"
        info "Fetching latest release from ${XELIS_REPO}..."
        LATEST_URL=$(curl -fsSL "https://api.github.com/repos/${XELIS_REPO}/releases/latest" \
            | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['tag_name'])" 2>/dev/null || true)

        if [[ -z "$LATEST_URL" ]]; then
            warn "Could not fetch latest release — trying 'latest'"
            TAG="latest"
        else
            TAG="$LATEST_URL"
            info "Latest release detected: ${TAG}"
        fi

        DL_BASE="https://github.com/${XELIS_REPO}/releases/download/${TAG}"
        TARBALL="xelis-blockchain-${PLATFORM}-${ARCH_TAG}.tar.gz"
        DL_URL="${DL_BASE}/${TARBALL}"

        info "Downloading ${DL_URL}..."
        TMP_DIR=$(mktemp -d)
        if curl -fsSL "$DL_URL" -o "${TMP_DIR}/xelis.tar.gz"; then
            info "Extracting..."
            tar -xzf "${TMP_DIR}/xelis.tar.gz" -C "$TMP_DIR"

            for bin in "${XELIS_MISSING[@]}"; do
                found_file=$(find "$TMP_DIR" -name "$bin" -type f 2>/dev/null | head -1)
                if [[ -n "$found_file" ]]; then
                    cp "$found_file" "${XELIS_DIR}/${bin}"
                    chmod +x "${XELIS_DIR}/${bin}"
                    success "${bin} downloaded to ${XELIS_DIR}"
                fi
            done

            mkdir -p "$BIN_DIR"
            for bin in "${XELIS_MISSING[@]}"; do
                if [[ -f "${XELIS_DIR}/${bin}" ]]; then
                    ln -sf "${XELIS_DIR}/${bin}" "${BIN_DIR}/${bin}"
                    success "Symbolic link created: ${BIN_DIR}/${bin}"
                fi
            done

            rm -rf "$TMP_DIR"

            if [[ ":${PATH}:" != *":${BIN_DIR}:"* ]]; then
                warn "${BIN_DIR} is not in your PATH"
                if [[ $INTERACTIVE -eq 1 ]]; then
                    prompt "Add ${BIN_DIR} to your PATH now? [Y/n]"
                    read -r PATH_ANSWER
                    PATH_ANSWER="${PATH_ANSWER:-Y}"
                    if [[ "$PATH_ANSWER" =~ ^[OoYy]$ ]]; then
                        SHELL_NAME=$(basename "$SHELL")
                        case "$SHELL_NAME" in
                            bash) echo "export PATH=\"${BIN_DIR}:\$PATH\"" >> ~/.bashrc
                                  success "Added to ~/.bashrc — run: source ~/.bashrc" ;;
                            zsh)  echo "export PATH=\"${BIN_DIR}:\$PATH\"" >> ~/.zshrc
                                  success "Added to ~/.zshrc — run: source ~/.zshrc" ;;
                            fish) echo "fish_add_path ${BIN_DIR}" >> ~/.config/fish/config.fish
                                  success "Added to fish config" ;;
                            *)    warn "Unknown shell ($SHELL_NAME) — add manually:"
                                  warn "  export PATH=\"${BIN_DIR}:\$PATH\" to your profile" ;;
                        esac
                    fi
                fi
            fi
        else
            error "Download failed from ${DL_URL}"
            warn "You can download manually from:"
            warn "  https://github.com/${XELIS_REPO}/releases"
            warn "  Place the binaries in ${XELIS_DIR}"
        fi
    else
        warn "Download skipped. You will need to install the binaries manually."
    fi
elif [[ $SKIP_XELIS -eq 1 ]]; then
    info "XELIS binary check skipped (--skip-xelis)"
fi

# ── PATH check ───────────────────────────────────────────────────────────────
export PATH="${BIN_DIR}:${XELIS_DIR}:${PATH}"

# ── Existing installation / update ────────────────────────────────────────────
if [[ -d "$INSTALL_DIR/src/.git" ]] && [[ $FORCE -eq 0 ]]; then
    step "Updating existing installation"
    if [[ $INTERACTIVE -eq 1 ]]; then
        prompt "Update existing installation? [Y/n]"
        read -r UP_ANSWER
        UP_ANSWER="${UP_ANSWER:-Y}"
    else
        UP_ANSWER="Y"
    fi

    if [[ "$UP_ANSWER" =~ ^[OoYy]$ ]]; then
        cd "$INSTALL_DIR/src"
        info "Fetching latest changes..."
        git pull --ff-only || warn "Could not update (conflict?)"
        success "Repository updated"
    else
        info "Update skipped. Use --force to reinstall."
    fi
else
    step "Installing XELIS Vault"
    mkdir -p "$INSTALL_DIR"
    cd "$INSTALL_DIR"

    if [[ -d "src" ]]; then
        rm -rf src
    fi
    info "Cloning ${REPO}..."
    git clone --depth 1 "$REPO_URL" src 2>&1 | sed 's/^/    /' || {
        error "Clone failed. Check your internet connection."
        exit 1
    }
    success "Repository cloned to ${INSTALL_DIR}/src"
fi

cd "$INSTALL_DIR/src"

# ── Directories ──────────────────────────────────────────────────────────────
mkdir -p "$CONFIG_DIR" "$LOGS_DIR" "$WALLET_DIR"

# ── Python virtual environment ────────────────────────────────────────────────
step "Setting up Python environment"

if [[ ! -d "$VENV_DIR" ]]; then
    info "Creating venv in ${VENV_DIR}..."
    python3 -m venv "$VENV_DIR"
    success "Venv created"
else
    info "Venv already exists"
fi

info "Installing Python dependencies..."
source "$VENV_DIR/bin/activate"
pip install --quiet --upgrade pip 2>/dev/null || true
pip install --quiet requests python-dotenv 2>/dev/null || true
success "Dependencies installed"
deactivate 2>/dev/null || true

# ── Config file ───────────────────────────────────────────────────────────────
step "Generating config file"

CONFIG_FILE="${CONFIG_DIR}/config.json"
if [[ ! -f "$CONFIG_FILE" ]] || [[ $FORCE -eq 1 ]]; then
    cat > "$CONFIG_FILE" <<JSON
{
  "version": "${VERSION}",
  "network": "testnet",
  "rpc_url": "http://127.0.0.1:18081",
  "wallet_url": "http://127.0.0.1:18082",
  "wallet_user": "wallet",
  "wallet_pass": "",
  "miner_endpoint": "",
  "miner_address": "",
  "enable_oracle": true,
  "enable_miner": true,
  "heartbeat_interval": 100,
  "price_update_interval": 100,
  "log_level": "INFO",
  "contracts": {
    "vault_swap": "${CONTRACT_VAULTSWAP}",
    "miner": "${CONTRACT_MINER}",
    "vlt_token": "${CONTRACT_VLT_TOKEN}",
    "vlt_asset": "${CONTRACT_VLT_ASSET}",
    "price_oracle": "${CONTRACT_ORACLE}",
    "psm": "${CONTRACT_PSM}",
    "governance_vault": "${CONTRACT_GOV_VAULT}",
    "registry": "${CONTRACT_REGISTRY}",
    "staked_oracle": "${CONTRACT_STAKED_ORACLE}",
    "oracle_governance": "${CONTRACT_ORACLE_GOV}",
    "xusd": "${CONTRACT_XUSD}",
    "xusd_asset": "${CONTRACT_XUSD_ASSET}",
    "vault_engine": "${CONTRACT_VAULT_ENGINE}",
    "governor": "${CONTRACT_GOVERNOR}",
    "guardian": "${CONTRACT_GUARDIAN}",
    "timelock": "${CONTRACT_TIMELOCK}"
  }
}
JSON
    success "Config written to ${CONFIG_FILE}"
else
    info "Config already exists (use --force to overwrite)"
fi

# ── XELIS wallet setup ───────────────────────────────────────────────────────
MINER_ADDRESS=""
WALLET_PASSWORD="testpass"

if [[ $SKIP_WALLET -eq 0 ]]; then
    step "Setting up XELIS wallet"

    WALLET_EXE=""
    for try in xelis_wallet "${XELIS_DIR}/xelis_wallet" "${BIN_DIR}/xelis_wallet"; do
        if command -v "$try" &>/dev/null; then
            WALLET_EXE="$try"
            break
        fi
        [[ -x "$try" ]] && { WALLET_EXE="$try"; break; }
    done

    WALLET_DB_PATH="${WALLET_DIR}/vault_wallet.db"

    if [[ -f "$WALLET_DB_PATH" ]] && [[ $FORCE -eq 0 ]]; then
        info "A wallet already exists at ${WALLET_DB_PATH}"
        if [[ -n "$WALLET_EXE" ]]; then
            "$WALLET_EXE" --wallet-path "$WALLET_DB_PATH" --password "$WALLET_PASSWORD" \
                --network testnet --daemon-address http://127.0.0.1:18081 \
                --disable-interactive-mode --rpc-bind-address 127.0.0.1:18085 \
                --rpc-username wallet --rpc-password "$WALLET_PASSWORD" &
            WALLET_PID=$!
            sleep 3
            ADDR_OUTPUT=$(curl -s --user "wallet:${WALLET_PASSWORD}" \
                -X POST http://127.0.0.1:18085/json_rpc \
                -H "Content-Type: application/json" \
                -d '{"method":"get_address","params":{},"id":1}' 2>/dev/null || true)
            MINER_ADDRESS=$(echo "$ADDR_OUTPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('result',''))" 2>/dev/null || true)
            kill "$WALLET_PID" 2>/dev/null || true
            if [[ -n "$MINER_ADDRESS" ]]; then
                success "Existing wallet address: ${MINER_ADDRESS}"
            fi
        fi
    else
        if [[ -z "$WALLET_EXE" ]]; then
            warn "xelis_wallet is not available"
            warn "You will need to create a wallet manually after installation."
            echo ""
            if [[ $INTERACTIVE -eq 1 ]]; then
                warn "Enter your existing XELIS address (or leave empty to continue):"
                prompt "XELIS address (xet:...):"
                read -r MINER_ADDRESS
            fi
        else
            echo ""
            if [[ $INTERACTIVE -eq 1 ]]; then
                prompt "Create a NEW wallet (n) or IMPORT an existing one (i)? [N/i]: "
                read -r WALLET_CHOICE
                WALLET_CHOICE="${WALLET_CHOICE:-N}"
            else
                WALLET_CHOICE="N"
            fi

            if [[ "$WALLET_CHOICE" =~ ^[Ii]$ ]]; then
                # Import existing wallet
                echo ""
                prompt "Enter your recovery phrase (24 words): "
                read -r WALLET_SEED
                prompt "Wallet password: "
                read -rs WALLET_PASSWORD
                echo ""
                if [[ -z "$WALLET_PASSWORD" ]]; then
                    WALLET_PASSWORD="testpass"
                fi

                info "Importing wallet..."
                "$WALLET_EXE" --seed "$WALLET_SEED" --password "$WALLET_PASSWORD" \
                    --wallet-path "$WALLET_DB_PATH" \
                    --daemon-address http://127.0.0.1:18081 --network testnet \
                    --rpc-bind-address 127.0.0.1:18082 --rpc-username wallet \
                    --rpc-password "$WALLET_PASSWORD" --disable-ascii-art \
                    --disable-interactive-mode --logs-path "$LOGS_DIR" --log-level info &
                WALLET_PID=$!
                sleep 4
                ADDR_OUTPUT=$(curl -s --user "wallet:${WALLET_PASSWORD}" \
                    -X POST http://127.0.0.1:18082/json_rpc \
                    -H "Content-Type: application/json" \
                    -d '{"method":"get_address","params":{},"id":1}' 2>/dev/null || true)
                MINER_ADDRESS=$(echo "$ADDR_OUTPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('result',''))" 2>/dev/null || true)
                kill "$WALLET_PID" 2>/dev/null || true
                sleep 1

                if [[ -n "$MINER_ADDRESS" ]]; then
                    success "Wallet imported successfully!"
                    success "Address: ${MINER_ADDRESS}"
                else
                    warn "Could not fetch address. Check your recovery phrase."
                    # Save seed for manual use
                    echo "$WALLET_SEED" > "${WALLET_DIR}/seed.txt"
                    chmod 600 "${WALLET_DIR}/seed.txt"
                    warn "Recovery phrase saved to ${WALLET_DIR}/seed.txt"
                fi
            else
                # Create new wallet
                echo ""
                info "Generating new wallet..."
                info "Starting xelis_wallet to create a new wallet..."

                WALLET_PASSWORD="testpass"

                # Launch wallet without seed so it generates one
                "$WALLET_EXE" --password "$WALLET_PASSWORD" \
                    --wallet-path "$WALLET_DB_PATH" \
                    --daemon-address http://127.0.0.1:18081 --network testnet \
                    --rpc-bind-address 127.0.0.1:18082 --rpc-username wallet \
                    --rpc-password "$WALLET_PASSWORD" --disable-ascii-art \
                    --disable-interactive-mode --logs-path "$LOGS_DIR" --log-level info &
                WALLET_PID=$!
                sleep 4

                # Fetch address
                ADDR_OUTPUT=$(curl -s --user "wallet:${WALLET_PASSWORD}" \
                    -X POST http://127.0.0.1:18082/json_rpc \
                    -H "Content-Type: application/json" \
                    -d '{"method":"get_address","params":{},"id":1}' 2>/dev/null || true)
                MINER_ADDRESS=$(echo "$ADDR_OUTPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('result',''))" 2>/dev/null || true)

                kill "$WALLET_PID" 2>/dev/null || true
                sleep 1

                if [[ -n "$MINER_ADDRESS" ]]; then
                    success "New wallet created!"
                    success "Address: ${MINER_ADDRESS}"
                    echo ""
                    warn "╔══════════════════════════════════════════════════════════════╗"
                    warn "║     WARNING: Save your recovery phrase!                    ║"
                    warn "║     The wallet was created with password:                  ║"
                    warn "║     ${WALLET_PASSWORD}                                       ║"
                    warn "║     The recovery phrase is in the logs above                ║"
                    warn "║     or in ${LOGS_DIR}/                  ║"
                    warn "╚══════════════════════════════════════════════════════════════╝"
                    echo ""

                    prompt "Did you save your recovery phrase? (y/N): "
                    read -r SEED_SAVED
                    if [[ ! "$SEED_SAVED" =~ ^[Oo]$ ]]; then
                        warn "Please save your phrase immediately!"
                        warn "   Launch the wallet with: xelis_wallet --wallet-path ${WALLET_DB_PATH}"
                    fi
                else
                    warn "Could not fetch new wallet address."
                    warn "Check the logs in ${LOGS_DIR}"
                fi
            fi
        fi
    fi

    # Save address to config
    if [[ -n "$MINER_ADDRESS" ]]; then
        cat > "${CONFIG_DIR}/wallet_address.txt" <<EOF
# XELIS Vault wallet address
# Generated by install.sh on $(date)
MINER_ADDRESS=${MINER_ADDRESS}
WALLET_PASSWORD=${WALLET_PASSWORD}
WALLET_DB=${WALLET_DB_PATH}
EOF
        chmod 600 "${CONFIG_DIR}/wallet_address.txt"
        success "Address saved to ${CONFIG_DIR}/wallet_address.txt"
    fi
else
    info "Wallet configuration skipped (--skip-wallet)"
fi

# ── Mining configuration ─────────────────────────────────────────────────────
step "Mining configuration"

echo ""
echo "${CYAN}╔══════════════════════════════════════════════════════════════════╗${RESET}"
echo "${CYAN}║              MINING SYSTEM EXPLANATION                          ║${RESET}"
echo "${CYAN}╠══════════════════════════════════════════════════════════════════╣${RESET}"
echo "${CYAN}║${RESET}                                                                  ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  To mine on XELIS Vault, you need:                              ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → 100 VLT (XELIS Vault Token) staked as collateral             ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → A public endpoint where your miner can be reached            ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → A synced XELIS daemon                                        ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}                                                                  ${CYAN}║${RESET}"
echo "${CYAN}╠══════════════════════════════════════════════════════════════════╣${RESET}"
echo "${CYAN}║${RESET}  HOW TO GET 100 VLT:                                           ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}                                                                  ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  a) Buy on an exchange (if listed)                              ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  b) Swap XEL → VLT on VaultSwapV2                               ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}     Contract: ${CONTRACT_VAULTSWAP::40}...  ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  c) Earn via staking in GovernanceVault                         ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}     Contract: ${CONTRACT_GOV_VAULT::40}...  ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  d) Future: protocol mining rewards                             ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}                                                                  ${CYAN}║${RESET}"
echo "${CYAN}╠══════════════════════════════════════════════════════════════════╣${RESET}"
echo "${CYAN}║${RESET}  REWARD FORMULA:                                               ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  Reward = Base × reputation_multiplier × budget_factor          ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → Base: fixed amount per distribution                         ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → reputation_multiplier: depends on your score                ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → budget_factor: depends on remaining protocol budget         ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}                                                                  ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  REPUTATION / HEARTBEAT SYSTEM:                                ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → Send a heartbeat every 100 blocks                            ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → 5 tiers: New, Bronze, Silver, Gold, Elite                   ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → Slashing for inactivity or abusive behavior                 ${CYAN}║${RESET}"
echo "${CYAN}║${RESET}  → Active miners receive more rewards                          ${CYAN}║${RESET}"
echo "${CYAN}╚══════════════════════════════════════════════════════════════════╝${RESET}"
echo ""

if [[ $INTERACTIVE -eq 1 ]]; then
    prompt "Enter your public endpoint URL (e.g. https://miner.example.com:8080): "
    read -r MINER_ENDPOINT
    MINER_ENDPOINT="${MINER_ENDPOINT:-}"

    if [[ -z "$MINER_ENDPOINT" ]]; then
        warn "No endpoint provided. You will need to configure it later."
        warn "(File: ${CONFIG_FILE}, key: miner_endpoint)"
    else
        success "Endpoint configured: ${MINER_ENDPOINT}"
    fi
else
    MINER_ENDPOINT=""
fi

# ── Update config with mining values ──────────────────────────────────────────
if [[ -n "$MINER_ENDPOINT" ]] || [[ -n "$MINER_ADDRESS" ]]; then
    # Update JSON via Python to avoid encoding issues
    python3 -c "
import json
path = '${CONFIG_FILE}'
with open(path) as f:
    cfg = json.load(f)
if '${MINER_ENDPOINT}':
    cfg['miner_endpoint'] = '${MINER_ENDPOINT}'
if '${MINER_ADDRESS}':
    cfg['miner_address'] = '${MINER_ADDRESS}'
    cfg['wallet_pass'] = '${WALLET_PASSWORD}'
with open(path, 'w') as f:
    json.dump(cfg, f, indent=2)
" 2>/dev/null || true
    success "Config updated with mining information"
fi

# ── .env file ─────────────────────────────────────────────────────────────────
ENV_FILE="${CONFIG_DIR}/.env"
if [[ ! -f "$ENV_FILE" ]] || [[ $FORCE -eq 1 ]]; then
    cat > "$ENV_FILE" <<EOF
# XELIS Vault v${VERSION} — Environment configuration
# Generated by install.sh on $(date)

WALLET_PATH=${WALLET_DIR}
XELIS_RPC=http://127.0.0.1:18081
WALLET_RPC=http://127.0.0.1:18082
WALLET_USER=wallet
WALLET_PASS=${WALLET_PASSWORD}
MINER_ADDRESS=${MINER_ADDRESS:-}
ENDPOINT_URL=${MINER_ENDPOINT:-}
SERVICES_MASK=1
LOG_LEVEL=INFO
CONTRACT_VAULTSWAP=${CONTRACT_VAULTSWAP}
CONTRACT_MINER=${CONTRACT_MINER}
CONTRACT_VLT_TOKEN=${CONTRACT_VLT_TOKEN}
CONTRACT_VLT_ASSET=${CONTRACT_VLT_ASSET}
CONTRACT_ORACLE=${CONTRACT_ORACLE}
CONTRACT_PSM=${CONTRACT_PSM}
CONTRACT_GOV_VAULT=${CONTRACT_GOV_VAULT}
CONTRACT_REGISTRY=${CONTRACT_REGISTRY}
CONTRACT_STAKED_ORACLE=${CONTRACT_STAKED_ORACLE}
CONTRACT_ORACLE_GOV=${CONTRACT_ORACLE_GOV}
CONTRACT_XUSD=${CONTRACT_XUSD}
CONTRACT_XUSD_ASSET=${CONTRACT_XUSD_ASSET}
CONTRACT_VAULT_ENGINE=${CONTRACT_VAULT_ENGINE}
CONTRACT_GOVERNOR=${CONTRACT_GOVERNOR}
CONTRACT_GUARDIAN=${CONTRACT_GUARDIAN}
CONTRACT_TIMELOCK=${CONTRACT_TIMELOCK}
EOF
    chmod 600 "$ENV_FILE"
    success ".env file created at ${ENV_FILE}"
else
    info ".env file already exists (use --force to overwrite)"
fi

# ── Install launcher ──────────────────────────────────────────────────────────
step "Installing xvault launcher"

mkdir -p "$BIN_DIR"
cat > "${BIN_DIR}/xvault" <<'LAUNCHER'
#!/usr/bin/env bash
# XELIS Vault — Launcher generated by install.sh
VAULT_DIR="__INSTALL_DIR__"
VENV="__VENV_DIR__/bin/python"
SCRIPT="__SRC_DIR__/scripts/xelis_vault_miner.py"
CONFIG="__CONFIG_DIR__/config.json"

usage() {
    echo "XELIS Vault — Miner/Oracle Launcher"
    echo ""
    echo "Usage: xvault [options]"
    echo ""
    echo "Options:"
    echo "  --miner           Start the miner daemon"
    echo "  --oracle          Start the oracle price bot"
    echo "  --wallet          Start the wallet (daemon)"
    echo "  --daemon          Start the XELIS daemon"
    echo "  --config <file>   Use a custom config file"
    echo "  --help, -h        Show this help"
    echo ""
    echo "Examples:"
    echo "  xvault --miner"
    echo "  xvault --oracle"
    echo "  xvault --wallet"
    echo "  xvault --daemon"
}

if [[ $# -eq 0 ]] || [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    usage
    exit 0
fi

case "$1" in
    --miner)
        shift
        exec "$VENV" "$SCRIPT" --config "$CONFIG" "$@"
        ;;
    --oracle)
        shift
        exec "$VENV" "__SRC_DIR__/price_bot.py" "$@"
        ;;
    --wallet)
        WALLET_DB="__WALLET_DIR__/vault_wallet.db"
        if [[ -f "__CONFIG_DIR__/wallet_address.txt" ]]; then
            source "__CONFIG_DIR__/wallet_address.txt"
        fi
        WALLET_PASS="${WALLET_PASSWORD:-testpass}"
        shift
        exec xelis_wallet \
            --seed "" \
            --password "$WALLET_PASS" \
            --wallet-path "$WALLET_DB" \
            --daemon-address http://127.0.0.1:18081 \
            --network testnet \
            --rpc-bind-address 127.0.0.1:18082 \
            --rpc-username wallet \
            --rpc-password "$WALLET_PASS" \
            --disable-ascii-art \
            --disable-interactive-mode \
            --logs-path "__LOGS_DIR__" \
            --log-level info \
            "$@"
        ;;
    --daemon)
        shift
        exec xelis_daemon \
            --network testnet \
            --dir-path "__INSTALL_DIR__/data" \
            --logs-path "__LOGS_DIR__" \
            --rpc-bind-address 127.0.0.1:18081 \
            --p2p-bind-address 0.0.0.0:2125 \
            --disable-ascii-art \
            --enable-contracts-logging \
            "$@"
        ;;
    *)
        echo "Unknown option: $1"
        usage
        exit 1
        ;;
esac
LAUNCHER

# Remplacer les placeholders
sed -i "s|__INSTALL_DIR__|${INSTALL_DIR}|g" "${BIN_DIR}/xvault"
sed -i "s|__VENV_DIR__|${VENV_DIR}|g" "${BIN_DIR}/xvault"
sed -i "s|__SRC_DIR__|${INSTALL_DIR}/src|g" "${BIN_DIR}/xvault"
sed -i "s|__CONFIG_DIR__|${CONFIG_DIR}|g" "${BIN_DIR}/xvault"
sed -i "s|__WALLET_DIR__|${WALLET_DIR}|g" "${BIN_DIR}/xvault"
sed -i "s|__LOGS_DIR__|${LOGS_DIR}|g" "${BIN_DIR}/xvault"

chmod +x "${BIN_DIR}/xvault"
success "Launcher installed: ${BIN_DIR}/xvault"
success "  xvault --help   → Help"
success "  xvault --miner  → Start miner"
success "  xvault --wallet → Start wallet"
success "  xvault --daemon → Start daemon"

# Add to PATH
if [[ ":${PATH}:" != *":${BIN_DIR}:"* ]]; then
    warn "${BIN_DIR} is not in your PATH"
    info "Add it to your shell profile:"
    SHELL_NAME=$(basename "$SHELL")
    case "$SHELL_NAME" in
        bash) info "  echo 'export PATH=\"${BIN_DIR}:\$PATH\"' >> ~/.bashrc" ;;
        zsh)  info "  echo 'export PATH=\"${BIN_DIR}:\$PATH\"' >> ~/.zshrc" ;;
        fish) info "  fish_add_path ${BIN_DIR}" ;;
        *)    info "  export PATH=\"${BIN_DIR}:\$PATH\"" ;;
    esac
fi

# ── Auto-start service ─────────────────────────────────────────────────────────
if [[ $SKIP_SERVICE -eq 0 ]] && [[ $INTERACTIVE -eq 1 ]]; then
    step "Configuring auto-start service"
    echo ""
    prompt "Set up automatic startup for daemon and wallet? [y/N]: "
    read -r SERVICE_ANSWER
    SERVICE_ANSWER="${SERVICE_ANSWER:-N}"

    if [[ "$SERVICE_ANSWER" =~ ^[OoYy]$ ]]; then
        if [[ "$PLATFORM" == "linux" ]]; then
            # systemd user service
            SYSTEMD_DIR="${HOME}/.config/systemd/user"
            mkdir -p "$SYSTEMD_DIR"

            # Service daemon
            cat > "${SYSTEMD_DIR}/xelis-daemon.service" <<EOF
[Unit]
Description=XELIS Daemon (testnet)
After=network.target

[Service]
Type=simple
ExecStart=${XELIS_DIR}/xelis_daemon --network testnet --dir-path ${INSTALL_DIR}/data --logs-path ${LOGS_DIR} --rpc-bind-address 127.0.0.1:18081 --p2p-bind-address 0.0.0.0:2125 --disable-ascii-art --enable-contracts-logging
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF
            chmod 644 "${SYSTEMD_DIR}/xelis-daemon.service"
            success "systemd service created: ${SYSTEMD_DIR}/xelis-daemon.service"

            # Service wallet
            cat > "${SYSTEMD_DIR}/xelis-wallet.service" <<EOF
[Unit]
Description=XELIS Wallet (testnet, vault)
After=xelis-daemon.service
BindsTo=xelis-daemon.service

[Service]
Type=simple
ExecStart=${BIN_DIR}/xvault --wallet
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
EOF
            chmod 644 "${SYSTEMD_DIR}/xelis-wallet.service"
            success "systemd service created: ${SYSTEMD_DIR}/xelis-wallet.service"

            info "To enable and start the services:"
            info "  systemctl --user daemon-reload"
            info "  systemctl --user enable --now xelis-daemon.service"
            info "  systemctl --user enable --now xelis-wallet.service"
            info ""
            info "To view the logs:"
            info "  journalctl --user -u xelis-daemon.service -f"
            info "  journalctl --user -u xelis-wallet.service -f"

        elif [[ "$PLATFORM" == "macos" ]]; then
            # launchd plist
            LAUNCHD_DIR="${HOME}/Library/LaunchAgents"
            mkdir -p "$LAUNCHD_DIR"

            # Daemon plist
            cat > "${LAUNCHD_DIR}/com.xelis.daemon.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xelis.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>${XELIS_DIR}/xelis_daemon</string>
        <string>--network</string>
        <string>testnet</string>
        <string>--dir-path</string>
        <string>${INSTALL_DIR}/data</string>
        <string>--logs-path</string>
        <string>${LOGS_DIR}</string>
        <string>--rpc-bind-address</string>
        <string>127.0.0.1:18081</string>
        <string>--p2p-bind-address</string>
        <string>0.0.0.0:2125</string>
        <string>--disable-ascii-art</string>
        <string>--enable-contracts-logging</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOGS_DIR}/daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>${LOGS_DIR}/daemon.stderr.log</string>
</dict>
</plist>
PLIST
            chmod 644 "${LAUNCHD_DIR}/com.xelis.daemon.plist"
            success "Launchd plist created: ${LAUNCHD_DIR}/com.xelis.daemon.plist"

            # Wallet plist
            cat > "${LAUNCHD_DIR}/com.xelis.wallet.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xelis.wallet</string>
    <key>ProgramArguments</key>
    <array>
        <string>${BIN_DIR}/xvault</string>
        <string>--wallet</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${LOGS_DIR}/wallet.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>${LOGS_DIR}/wallet.stderr.log</string>
</dict>
</plist>
PLIST
            chmod 644 "${LAUNCHD_DIR}/com.xelis.wallet.plist"
            success "Launchd plist created: ${LAUNCHD_DIR}/com.xelis.wallet.plist"

            info "To enable and start the services:"
            info "  launchctl load ${LAUNCHD_DIR}/com.xelis.daemon.plist"
            info "  launchctl load ${LAUNCHD_DIR}/com.xelis.wallet.plist"
            info ""
            info "To view the logs:"
            info "  tail -f ${LOGS_DIR}/daemon.stdout.log"
            info "  tail -f ${LOGS_DIR}/wallet.stdout.log"
        fi
    else
        info "Auto-start service skipped"
    fi
fi

# ── Final summary ─────────────────────────────────────────────────────────────
printf "\n"
printf "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════${RESET}\n"
printf "${GREEN}${BOLD}                                                                ${RESET}\n"
printf "${GREEN}${BOLD}   XELIS Vault installed successfully!                          ${RESET}\n"
printf "${GREEN}${BOLD}                                                                ${RESET}\n"
printf "${GREEN}${BOLD}══════════════════════════════════════════════════════════════════${RESET}\n"
printf "\n"

printf "${BOLD}INSTALLATION SUMMARY${RESET}\n\n"

# Wallet address
if [[ -n "$MINER_ADDRESS" ]]; then
    printf "  ${CYAN}Wallet address:${RESET}\n"
    printf "    ${BOLD}${MINER_ADDRESS}${RESET}\n\n"
else
    printf "  ${YELLOW}Wallet address:${RESET} Not configured\n\n"
fi

# XELIS daemon status
DAEMON_RUNNING=0
if command -v xelis_daemon &>/dev/null || [[ -f "${XELIS_DIR}/xelis_daemon" ]]; then
    DAEMON_PATH=$(command -v xelis_daemon || echo "${XELIS_DIR}/xelis_daemon")
    if pgrep -f xelis_daemon &>/dev/null; then
        printf "  ${GREEN}XELIS Daemon:${RESET} Running ✓\n"
        DAEMON_RUNNING=1
    else
        printf "  ${YELLOW}XELIS Daemon:${RESET} Installed but not running\n"
    fi
else
    printf "  ${RED}XELIS Daemon:${RESET} Not installed\n"
fi

# Version
printf "  ${CYAN}Installed version:${RESET} ${VERSION}\n"
printf "  ${CYAN}Directory:${RESET} ${INSTALL_DIR}\n"
printf "  ${CYAN}Config:${RESET} ${CONFIG_FILE}\n"
printf "  ${CYAN}Logs:${RESET} ${LOGS_DIR}\n\n"

printf "${BOLD}NEXT STEPS${RESET}\n\n"

# VLT guide
printf "  ${CYAN}1.${RESET} ${BOLD}Get 100 VLT to stake${RESET}\n"
printf "     Mining requires 100 VLT staked as collateral.\n"
printf "     Here is how to get VLT:\n"
printf "\n"
printf "     ${BOLD}a) Buy on an exchange${RESET} (if listed)\n"
printf "        Check availability on centralized exchanges.\n"
printf "\n"
printf "     ${BOLD}b) Swap XEL → VLT on VaultSwapV2${RESET}\n"
printf "        Contract address: ${DIM}${CONTRACT_VAULTSWAP}${RESET}\n"
printf "        Deposit XEL and swap for VLT through the interface.\n"
printf "        Wallet commands:\n"
printf "          1. Deposit XEL on VaultSwapV2\n"
printf "          2. Call swap(XEL, VLT, amount, min_out)\n"
printf "\n"
printf "     ${BOLD}c) Stake in GovernanceVault${RESET}\n"
printf "        If you already have VLT, stake them in\n"
printf "        GovernanceVault (${DIM}${CONTRACT_GOV_VAULT::32}...${RESET})\n"
printf "        to earn staking rewards.\n"
printf "\n"
printf "     ${BOLD}d) Protocol Mining (future)${RESET}\n"
printf "        Protocol mining rewards will be\n"
printf "        available in a future release.\n"

printf "\n"
printf "  ${CYAN}2.${RESET} ${BOLD}Configure mining${RESET}\n"
printf "     Once you have 100 VLT, register as a miner:\n"
printf "       xvault --miner\n"
printf "     Or manually:\n"
printf "       python3 ${INSTALL_DIR}/src/scripts/xelis_vault_miner.py \\\\\n"
printf "         --config ${CONFIG_FILE}\n"

printf "\n"
printf "  ${CYAN}3.${RESET} ${BOLD}Start the XELIS daemon${RESET}\n"
if [[ $DAEMON_RUNNING -eq 0 ]]; then
    if [[ -f "${XELIS_DIR}/xelis_daemon" ]]; then
        printf "     Run: xvault --daemon\n"
        printf "     Or:  ${XELIS_DIR}/xelis_daemon --network testnet \\\\\n"
        printf "               --dir-path ${INSTALL_DIR}/data --logs-path ${LOGS_DIR} \\\\\n"
        printf "               --rpc-bind-address 127.0.0.1:18081 &\n"
    else
        printf "     Download xelis_daemon first from:\n"
        printf "     https://github.com/xelis-project/xelis-blockchain/releases\n"
    fi
fi

printf "\n"
printf "  ${CYAN}4.${RESET} ${BOLD}Start the wallet${RESET}\n"
printf "     xvault --wallet\n"
if [[ -n "$MINER_ADDRESS" ]]; then
    printf "     Address: ${MINER_ADDRESS}\n"
fi

printf "\n"
printf "  ${CYAN}5.${RESET} ${BOLD}Heartbeats${RESET}\n"
printf "     The miner automatically sends a heartbeat every 100\n"
printf "     blocks. Your reputation determines your share of rewards.\n"
printf "     Reputation tiers: New < Bronze < Silver < Gold < Elite\n"

printf "\n"
printf "  ${CYAN}6.${RESET} ${BOLD}Deployed contracts (testnet)${RESET}\n"
printf "     VaultSwapV2      ${DIM}${CONTRACT_VAULTSWAP}${RESET}\n"
printf "     XelisVaultMiner  ${DIM}${CONTRACT_MINER}${RESET}\n"
printf "     VLTToken         ${DIM}${CONTRACT_VLT_TOKEN}${RESET}\n"
printf "     VLT Asset        ${DIM}${CONTRACT_VLT_ASSET}${RESET}\n"
printf "     PriceOracle      ${DIM}${CONTRACT_ORACLE}${RESET}\n"
printf "     PSM              ${DIM}${CONTRACT_PSM}${RESET}\n"
printf "     GovernanceVault  ${DIM}${CONTRACT_GOV_VAULT}${RESET}\n"
printf "     StakedOracle     ${DIM}${CONTRACT_STAKED_ORACLE}${RESET}\n"
printf "     OracleGovernance ${DIM}${CONTRACT_ORACLE_GOV}${RESET}\n"
printf "     ContractRegistry ${DIM}${CONTRACT_REGISTRY}${RESET}\n"

printf "\n"
printf "${DIM}──────────────────────────────────────────────────────────────────${RESET}\n"
printf "${DIM}  Config:         ${CONFIG_FILE}${RESET}\n"
printf "${DIM}  Logs:           ${LOGS_DIR}${RESET}\n"
printf "${DIM}  Documentation:  https://github.com/${REPO}${RESET}\n"
